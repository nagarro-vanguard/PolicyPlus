{
    "name": "@nagarro/create-work-item-scripts",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "bun": ">=1.4.0"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "bun --bun vitest run",
        "lint": "eslint .",
        "format": "prettier --write '**/*.ts'",
        "format:check": "prettier --check '**/*.ts'",
        "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/bun": "1.4.2",
        "eslint": "10.12.0",
        "eslint-plugin-jsdoc": "65.1.0",
        "jiti": "2.7.0",
        "prettier": "3.9.9",
        "typescript": "5.9.3",
        "typescript-eslint": "8.71.0",
        "vitest": "5.0.3"
    }
}

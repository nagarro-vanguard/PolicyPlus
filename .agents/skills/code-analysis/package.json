{
    "name": "@nagarro/code-analysis",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "bun": ">=1.4.0"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write '**/*.{ts,tsx}'",
        "format:check": "prettier --check '**/*.{ts,tsx}'",
        "knip": "knip && knip --production",
        "check": "bun run format:check && bun run lint && bun run knip && bun run typecheck && bun run check-schema-docs && bun run test",
        "test": "bun test ./tests",
        "check-schema-docs": "bun cli/check-schema-docs.ts"
    },
    "dependencies": {
        "@effect/platform-bun": "4.0.0",
        "@effect/sql-sqlite-bun": "4.0.0",
        "chardet": "2.2.0",
        "effect": "4.0.0",
        "iconv-lite": "0.7.3",
        "ignore": "7.0.5"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/bun": "1.4.2",
        "eslint": "10.12.0",
        "eslint-plugin-boundaries": "7.2.0",
        "eslint-plugin-import-x": "4.17.1",
        "eslint-plugin-jsdoc": "65.1.0",
        "jiti": "2.7.0",
        "knip": "6.39.0",
        "prettier": "3.9.9",
        "typescript": "5.9.3",
        "typescript-eslint": "8.71.0"
    }
}

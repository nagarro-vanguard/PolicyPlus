{
    "name": "@nagarro/shape-and-deliver-scripts",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "bun": ">=1.4.0"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write '**/*.{ts,tsx}'",
        "format:check": "prettier --check '**/*.{ts,tsx}'",
        "check": "bun run format:check && bun run lint && bun run typecheck"
    },
    "dependencies": {
        "@effect/platform-bun": "4.0.4",
        "beautiful-mermaid": "1.1.3",
        "effect": "4.0.4",
        "typescript": "5.9.3"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/bun": "1.4.2",
        "eslint": "10.12.0",
        "eslint-plugin-import-x": "4.17.1",
        "eslint-plugin-jsdoc": "65.1.0",
        "jiti": "2.7.0",
        "prettier": "3.9.9",
        "typescript-eslint": "8.71.0",
        "vite": "8.3.2"
    },
    "overrides": {
        "@effect/platform-node-shared": "4.0.4"
    }
}

{
    "name": "@nagarro/scaffold-codebase",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": { "bun": ">=1.4.0" },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "format": "prettier --write '**/*.ts'",

{
    "name": "@nagarro/app",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "The pages and diagrams built from a finished analysis's payloads and, when there is one, a modernization plan. Run through a skill's build-app command, never by hand.",
    "engines": {
        "bun": ">=1.4.0"
    },
    "scripts": {
        "generate": "bun scripts/generate-schemas.ts",
        "check": "bun run generate && astro check",
        "build": "bun run generate && astro build",
        "test": "bun test",
        "test:contract": "bun test ./tests/contract/reader-contract.contract.ts ./tests/contract/site.contract.ts",
        "test:contract:offline": "bun tests/contract/offline.ts",
        "contract:report": "bun tests/contract/run.ts"
    },
    "dependencies": {
        "@astrojs/react": "7.1.9",
        "@xyflow/react": "13.0.1",
        "astro": "7.4.12",
        "elkjs": "0.12.1",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@astrojs/check": "0.9.12",
        "@types/bun": "1.4.2",
        "json-schema-to-zod": "2.8.1",
        "typescript": "6.0.3"
    }
}

{
    "name": "@nagarro/app",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "The pages and diagrams built from a finished analysis's payloads and, when there is one, a modernization plan. Run through a skill's build-app command, never by hand.",
    "engines": {
        "bun": ">=1.4.0"
    },
    "scripts": {
        "generate": "bun scripts/generate-schemas.ts",
        "sync-ui": "bun scripts/sync-ui.ts",
        "check": "bun scripts/sync-ui.ts --check && bun run generate && astro check",
        "build": "bun scripts/sync-ui.ts --check && bun run generate && astro build"
    },
    "dependencies": {
        "@astrojs/react": "7.1.9",
        "@base-ui/react": "1.9.0",
        "@tailwindcss/node": "4.3.3",
        "@tailwindcss/vite": "4.3.3",
        "@xyflow/react": "13.0.1",
        "astro": "7.4.12",
        "class-variance-authority": "0.7.1",
        "cn": "0.4.0",
        "elkjs": "0.12.1",
        "lucide-react": "1.59.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "rolldown": "1.2.19",
        "tailwindcss": "4.3.3",
        "tw-animate-css": "1.4.0",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@astrojs/check": "0.9.12",
        "@types/bun": "1.4.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "json-schema-to-zod": "2.8.1",
        "typescript": "6.0.3"
    }
}

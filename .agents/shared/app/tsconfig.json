{
    "extends": "astro/tsconfigs/strict",
    "include": [".astro/types.d.ts", "src/**/*", "tests/**/*", "scripts/**/*", "compose/**/*"],
    "exclude": ["dist"],
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "types": ["bun"],
        "noUncheckedIndexedAccess": true
    }
}

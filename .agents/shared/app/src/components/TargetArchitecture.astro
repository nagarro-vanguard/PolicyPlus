---
import Page from "../layouts/Page.astro";
import { draw } from "../lib/target-diagram";
import { containers, context, domainMap } from "../lib/target-views";
import ConfirmBar from "./ConfirmBar.astro";
import { confirmCommand } from "../lib/confirmation";
import type { Architecture, Choice, Journey, Legacy, TargetData } from "../lib/target-types";
export interface Props { variants: readonly Architecture[]; choice: Choice | undefined; journeys: readonly Journey[]; legacy: Legacy | undefined; data: TargetData; }
const { variants, choice, journeys, legacy, data } = Astro.props;
const picked = data.gates.architecture.state === "confirmed" ? choice?.picks[0]?.variant : undefined;
const drawn = await Promise.all(variants.map(async (variant) => ({ variant, context: await draw(context(variant, journeys, legacy)), domains: await draw(domainMap(variant)), containers: await draw(containers(variant)) })));
---
<Page title="Architecture" lead="Ways of cutting the system into domains and parts. The choice rests on how many steps and rules each cut can carry, and what it costs." depth={1} trail={[{ text: "Overview", href: "../index.html" }, { text: "Target", href: "../target.html" }, { text: "Architecture" }]}>
    <ConfirmBar data={data} show={["architecture"]} />
    {variants.length === 0 && <p class="note">No variants yet: the architecture stage has not run.</p>}
    {drawn.map(({ variant, context: c1, domains, containers: c2 }) => {
        const score = variant.score;
        return <section class={`variant${picked === variant.name ? " chosen" : ""}`}>
            <h2>{variant.name}</h2>
            <p class="tags">{variant.recommended && <span class="badge new">recommended</span>} {picked === variant.name && <span class="badge correct">chosen</span>}</p>
            <p>{variant.idea}</p>
            <p class="sub">Costs: {variant.tradeoff}</p>
            {variant.recommended && <p class="sub">Recommended because {variant.recommended}</p>}
            {score && <div class="metrics">
                <div><strong>{score.stepsServed} of {score.steps}</strong>steps served by a domain</div>
                <div><strong>{score.rulesAssigned} of {score.rules}</strong>rules in a domain</div>
                <div><strong>{score.idleDomains.length}</strong>domains serving no step</div>
                <div><strong>{variant.domains.length}</strong>domains</div>
                <div><strong>{variant.containers.length}</strong>containers</div>
            </div>}
            <h3>Risks</h3>
            <ul>{variant.risks.map((risk) => <li>{risk}</li>)}</ul>
            <h3>Who uses it and what it reaches</h3>
            <Fragment set:html={c1} />
            <h3>Domains</h3>
            <Fragment set:html={domains} />
            <h3>What is built and run</h3>
            <Fragment set:html={c2} />
            {picked !== variant.name && <details><summary class="sub">Choose this architecture</summary><pre class="prompt">{confirmCommand("architecture", data.root).replace("<variant>", variant.name)}</pre></details>}
        </section>;
    })}
</Page>

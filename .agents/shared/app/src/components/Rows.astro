---
import type { RowView } from "../case/view";
import Badge from "./ui/Badge.astro";
// Rows of the next level or of a fold: the name, one line, the count in that level's noun, the kind of place and a risk
// word with its icon. A row that opens something is a link; the rest are plain rows.
export interface Props {
    rows: readonly RowView[];
    root: string;
}
const { rows, root } = Astro.props;
---
<div class="list">
    {rows.map((row) => {
        const Tag = row.href === undefined ? "div" : "a";
        return <Tag class="row" href={row.href === undefined ? undefined : `${root}${row.href}`}>
            <span class="t" data-written-by="agent">{row.name}</span>
            <span class="r">
                {row.kind !== undefined && <span class="badge" data-written-by="agent">{row.kind}</span>}
                {row.risk !== undefined && <span data-written-by="app"><Badge kind={row.risk.badge} label={row.risk.word} /></span>}
                {row.count !== undefined && <span title={row.count.scope} data-written-by="app">{row.count.text}</span>}
            </span>
            {row.line !== undefined && <span class="d" data-written-by="agent">{row.line}</span>}
        </Tag>;
    })}
</div>

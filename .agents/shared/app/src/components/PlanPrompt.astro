---
import { copy } from "../lib/copy";
export interface Props { title: string; text: string; lead: string; }
const { title, text, lead } = Astro.props;
---
<div class="prompt-box">
    <p class="note">{lead}</p>
    <button class="copy" hidden data-needs-js data-copy-text={text} data-copied={copy.site.copied} aria-label={copy.plan.copyPromptFor(title)}><span data-label>{copy.plan.copyPrompt}</span></button>
    <pre class="prompt" data-prompt tabindex="0">{text}</pre>
</div>

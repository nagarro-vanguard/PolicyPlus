---
import Page from "../layouts/Page.astro";
import "../styles/plan.css";
import Details from "./ui/Details.astro";
import Section from "./ui/Section.astro";
import PromptFold from "./plan/PromptFold.astro";
import { copy } from "../lib/copy";
import { decisionsByTopic, layerName, planHomePath, previewFolder, subjectOf } from "../lib/plan";
import type { PlanData } from "../lib/plan-data";
import { words } from "../lib/plan-words";
export interface Props { data: PlanData; }
const { data } = Astro.props;
const { plan, prompts, previews } = data;
const root = "../";
const names = new Map(plan.layers.map((layer) => [layer.id, layer.name] as const));
const rootPreview = previews.get("");
const layerKind = (kind: string) => copy.plan.layerKinds[kind as keyof typeof copy.plan.layerKinds] ?? kind;
const withPreview = plan.layers.flatMap((layer) => { const text = previews.get(previewFolder(layer)); return text === undefined ? [] : [{ layer, text }]; });
---
<Page wide title={words.foundationTitle} lead={copy.plan.foundationLead} depth={1} trail={[{ text: "Overview", href: `${root}index.html` }, { text: "Modernization plan", href: `${root}${planHomePath}.html` }, { text: words.foundationTitle }]}>
    <Section title={words.layers}>
        <ul class="pl-grid">{plan.layers.map((layer) => <li class="pl-panel pl-layer">
            <div class="pl-head"><h3>{layer.name}</h3>{layer.kind !== "code" && <span class="pl-chip">{layerKind(layer.kind)}</span>}</div>
            <p>{layer.purpose}</p>
            <p class="pl-sub"><code>{layer.path}</code></p>
            <p class="pl-meta"><span>{words.checkedBy}</span><code>{layer.check}</code></p>
            {layer.dependsOn.length > 0 && <p class="pl-meta"><span>{words.dependsOn}</span>{layer.dependsOn.map((id) => <span class="pl-chip">{names.get(id) ?? id}</span>)}</p>}
        </li>)}</ul>
    </Section>
    <Section title={words.decisions}>
        <div class="pl-stack">{decisionsByTopic(plan.decisions).map((group) => <Details summary={`${copy.plan.decisionTopics[group.topic]} (${group.decisions.length})`}>
            <ul class="pl-decisions">{group.decisions.map((decision) => <li class="pl-decision">
                <p><strong>{subjectOf(decision, layerName(plan, decision.layer))}</strong></p>
                <p>{decision.chose}</p>
                <p class="pl-sub">{words.tradeOff}: {decision.reason}</p>
                {group.topic !== "convention" && <p class="pl-meta"><span>{words.governs}</span><span class="pl-chip">{layerName(plan, decision.layer)}</span></p>}
            </li>)}</ul>
        </Details>)}</div>
    </Section>
    <Section title={words.rulesFiles}>
        <p class="pl-note">{words.rulesFilesNote}</p>
        {rootPreview !== undefined && <Details summary={words.rulesRoot}><pre class="prompt" tabindex="0">{rootPreview}</pre></Details>}
        {withPreview.map(({ layer, text }) => <Details summary={layer.name}><pre class="prompt" tabindex="0">{text}</pre></Details>)}
    </Section>
    <PromptFold id="scaffold" summary={words.scaffold} note={words.scaffoldNote} text={prompts.scaffold} />
</Page>

---
// The decision bar: one line above the pages that are read to make a decision, saying where it stands and linking its review page.
import "../styles/target.css";
import GateState from "./target/GateState.astro";
import { gates } from "../lib/confirmation";
import type { Gate } from "../lib/confirmation";
import { gateNames } from "../lib/slice";
import { blockedBy } from "../lib/target-page";
import type { TargetData } from "../lib/target-types";
export interface Props {
    data: TargetData;
    show: readonly Gate[];
    /** The way up to the site's root from this page, such as `../`. */
    root?: string;
}
const { data, show, root = "../" } = Astro.props;
const names = gateNames;
---
{show.map((gate) => {
    const view = data.gates[gate];
    const by = blockedBy(gate, data);
    return <p class="tx-confirm">
        <strong>{names[gate]}</strong>
        <GateState state={view.state} date={view.date} by={by === undefined ? undefined : gates.indexOf(by) + 1} />
        <a href={`${root}gate/${gate}.html`}>{view.state === "confirmed" ? "Review again" : "Review and confirm"}</a>
    </p>;
})}

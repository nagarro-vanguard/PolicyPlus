---
// A short chain of chips in order, each a link: the layers an action passes through.
import "../../styles/analysis.css";
export interface Props {
    steps: readonly { text: string; href: string }[];
    label: string;
}
const { steps, label } = Astro.props;
---
<ol class="a-chain" aria-label={label}>
    {steps.map((step) => <li><a class="a-step" href={step.href}>{step.text}</a></li>)}
</ol>

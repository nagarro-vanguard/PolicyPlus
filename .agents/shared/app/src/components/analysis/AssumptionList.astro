---
// The assumptions we made. Each is one line (the assumption and whom it is about) that opens to why no file settles it, what would
// confirm it, what changes if we are wrong, and where it rests in the code.
import "../../styles/analysis.css";
import NoDataState from "../ui/NoDataState.astro";
import EvidenceChip from "../ui/EvidenceChip.astro";
import { words } from "../../lib/analysis-copy";
import { compareText, where } from "../../lib/text";
import { subjectWords, wordFor } from "../../lib/words";
import type { Knowledge } from "../../lib/types";
export interface Props {
    assumptions: Knowledge["assumptions"];
}
const { assumptions } = Astro.props;
const sorted = assumptions.toSorted((one, other) => compareText(one.subject.name, other.subject.name) || compareText(one.statement, other.statement));
---
{sorted.length === 0 && <NoDataState compact title={words.runs.noAssumptionsTitle} message={words.runs.noAssumptions} />}
{sorted.length > 0 && <div class="a-groups">
    {sorted.map((item) => <details class="a-item-fold">
        <summary><span>{item.statement}<span class="a-note"> {wordFor(subjectWords, item.subject.kind)}: {item.subject.name}</span></span></summary>
        <div class="a-body">
            <dl>
                <dt>{words.runs.why}</dt><dd>{item.why}</dd>
                <dt>{words.runs.confirm}</dt><dd>{item.confirmWith}</dd>
                <dt>{words.runs.ifWrong}</dt><dd>{item.ifWrong}</dd>
            </dl>
            {item.evidence.length > 0 && <div class="a-evidence">{item.evidence.map((place) => <EvidenceChip place={where(place)} />)}</div>}
        </div>
    </details>)}
</div>}

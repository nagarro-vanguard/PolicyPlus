---
// A prompt to copy into a coding assistant, folded: the summary names it, the body holds one line, the copy button and the text.
import Details from "../ui/Details.astro";
import Button from "../ui/Button.astro";
import { words } from "../../lib/plan-words";
export interface Props {
    summary: string;
    note: string;
    text: string;
    id?: string;
    open?: boolean;
}
const { summary, note, text, id, open = false } = Astro.props;
---
<div class="pl-prompt" id={id}>
    <Details summary={summary} open={open}>
        <p class="pl-note">{note}</p>
        <div class="pl-copy" data-needs-js hidden><Button copy={text} copied="Copied" icon="copy">{words.copy}</Button></div>
        <pre class="prompt" data-prompt tabindex="0">{text}</pre>
    </Details>
</div>

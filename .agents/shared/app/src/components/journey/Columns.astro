---
// The two columns of a journey, row by row: how it works today beside how it would work, so a reader sees what each old step
// became. A step of the proposed way sits next to the steps of today it replaces; the tag says how (kept, changed, merged,
// defaulted, new) and the line under it is the reason. Today's steps carry what the system does. A step nothing replaces says why when a drop explains it.
import "../../styles/journey.css";
import Badge from "../ui/Badge.astro";
import { alignRows } from "../../lib/journey-join";
import type { Journey } from "../../lib/journey-join";
import { journeyCopy } from "../../lib/journey-copy";
import { lensOf } from "../../lib/journey-lens";
export interface Props {
    journey: Journey;
    /** What the old system did for an action, by id, for the reason a step has none. */
    dropReason: (ids: readonly string[]) => string | undefined;
}
const { journey, dropReason } = Astro.props;
const way = journey.way;
const rows = alignRows(journey.today.current, way);
const words = journeyCopy.page;
---
<div class="jr-cmp wide" data-lens-root data-lens={lensOf("", way !== undefined)}>
    <div class="jr-head" aria-hidden="true">
        <span class="jr-t">{words.todayHead}</span>
        {way !== undefined && <span class="jr-m">{words.modernHead(way.name)}</span>}
    </div>
    {rows.map((row) => <div class="jr-row">
        <div class="jr-t" data-label={words.today}>
            {row.today.length === 0
                ? <p class="jr-none">{words.nothingToday}</p>
                : row.today.map(({ at, step }) => <div class="jr-step">
                    <p class="jr-n"><span class="jr-no">{at + 1}</span>{step.intent}{step.confidence === "sure" ? "" : <Badge kind="inferred" label="Inferred" />}</p>
                    <p class="jr-s">{step.system}</p>
                </div>)}
        </div>
        {way !== undefined && <div class="jr-m" data-label={words.modernized}>
            {row.modern.length === 0
                ? <p class="jr-none">{dropReason(row.today.flatMap(({ step }) => step.from)) ?? words.notCarried}</p>
                : row.modern.map(({ step }) => <div class="jr-step">
                    <p class="jr-n"><span class="jr-tag" data-kind={step.link._tag === "new" ? "new" : step.link.change}>{step.link._tag === "new" ? "new" : step.link.change}</span>{step.intent}{step.confidence === "sure" ? "" : <Badge kind="inferred" label="Inferred" />}</p>
                    <p class="jr-s">{step.link.reason}</p>
                </div>)}
        </div>}
    </div>)}
</div>

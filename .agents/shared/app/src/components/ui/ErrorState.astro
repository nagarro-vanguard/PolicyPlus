---
// Error says what went wrong and offers the control that tries again; it is announced and is not an empty list.
import Icon from "./Icon.astro";
export interface Props {
    title: string;
    message: string;
    compact?: boolean;
}
const { title, message, compact = false } = Astro.props;
---
<div class={`state state-error${compact ? " state-compact" : ""}`} role="alert">
    <span class="state-icon"><Icon name="alert-circle" /></span>
    <div>
        <p class="state-title">{title}</p>
        <p class="state-message">{message}</p>
    </div>
    <slot />
</div>

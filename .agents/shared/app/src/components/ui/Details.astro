---
// A fold: the summary is the control, the rest shows on demand. Shut unless `open` is given.
export interface Props {
    summary: string;
    open?: boolean;
}
const { summary, open = false } = Astro.props;
---
<details class="fold" open={open}>
    <summary>{summary}</summary>
    <div class="fold-body"><slot /></div>
</details>

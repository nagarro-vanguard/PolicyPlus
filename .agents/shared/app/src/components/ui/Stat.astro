---
// A number with its unit word, never bare, in tabular figures; the label says what is counted.
export interface Props {
    value: number | string;
    unit: string;
    label?: string;
}
const { value, unit, label } = Astro.props;
---
<div class="stat">
    {label !== undefined && <span class="stat-label">{label}</span>}
    <span class="stat-figure"><span class="stat-value">{value}</span> <span class="stat-unit">{unit}</span></span>
</div>

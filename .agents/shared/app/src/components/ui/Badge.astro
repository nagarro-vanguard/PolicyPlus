---
import Icon, { type IconName } from "./Icon.astro";
// A short label with an icon and a word, never colour alone. Kinds: neutral; severity high, medium, low; state
// changes-state, read-only; provenance stated, inferred, assumed. The word is the kind's own unless `label` is given.
export type Kind = "neutral" | "high" | "medium" | "low" | "changes-state" | "read-only" | "stated" | "inferred" | "assumed";
export interface Props {
    kind?: Kind;
    label?: string;
}
const { kind = "neutral", label } = Astro.props;
const known: Record<Exclude<Kind, "neutral">, { icon: IconName; word: string }> = {
    high: { icon: "alert-triangle", word: "High" },
    medium: { icon: "alert-circle", word: "Medium" },
    low: { icon: "info", word: "Low" },
    "changes-state": { icon: "pencil", word: "Changes state" },
    "read-only": { icon: "eye", word: "Read only" },
    stated: { icon: "check-circle", word: "Stated by the code" },
    inferred: { icon: "search", word: "Inferred" },
    assumed: { icon: "help-circle", word: "Assumed" },
};
const shown = kind === "neutral" ? undefined : known[kind];
---
<span class={`badge${kind === "neutral" ? "" : ` badge-${kind}`}`}>
    {shown !== undefined && <Icon name={shown.icon} />}
    <span>{label ?? shown?.word ?? ""}<slot /></span>
</span>

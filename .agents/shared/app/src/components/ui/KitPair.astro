---
// Shows what it holds twice, once in the light theme and once in the dark, so a component is judged in both at once.
export interface Props {
    density?: "compact" | "cozy";
}
const { density = "compact" } = Astro.props;
const inner = await Astro.slots.render("default");
const themes = ["light", "dark"] as const;
---
<div class="kit-grid">
    {themes.map((theme) => <div class="kit-panel" data-theme={theme} data-density={density === "cozy" ? "cozy" : undefined}>
        <p class="note">{theme === "light" ? "Light" : "Dark"}{density === "cozy" ? ", cozy density" : ""}</p>
        <Fragment set:html={inner} />
    </div>)}
</div>

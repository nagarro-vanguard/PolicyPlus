---
// The way down to this page: the whole system first, the current place last and not a link.
export interface Props {
    steps: readonly { text: string; href?: string }[];
}
const { steps } = Astro.props;
---
{steps.length > 0 && <nav class="trail" aria-label="Trail">
    <ol>
        {steps.map((step, i) => {
            const last = i === steps.length - 1;
            return <li>
                {step.href !== undefined && !last ? <a href={step.href}>{step.text}</a> : <span aria-current={last ? "page" : undefined}>{step.text}</span>}
                {!last && <span aria-hidden="true">/</span>}
            </li>;
        })}
    </ol>
</nav>}

---
// No data says why and what to do next; it is not an error.
import Icon from "./Icon.astro";
export interface Props {
    title: string;
    message: string;
    compact?: boolean;
}
const { title, message, compact = false } = Astro.props;
---
<div class={`state state-empty${compact ? " state-compact" : ""}`}>
    <span class="state-icon"><Icon name="inbox" /></span>
    <div>
        <p class="state-title">{title}</p>
        <p class="state-message">{message}</p>
    </div>
    <slot />
</div>

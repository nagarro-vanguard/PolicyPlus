---
// A place in the code, `file:line` in mono; a click copies it. The same chip wherever a claim shows its evidence.
import Icon from "./Icon.astro";
export interface Props {
    place: string;
}
const { place } = Astro.props;
---
<button type="button" class="chip-evidence" data-copy-text={place} data-copied="Copied" aria-label={`Copy ${place}`}>
    <span data-label>{place}</span>
    <Icon name="copy" />
</button>

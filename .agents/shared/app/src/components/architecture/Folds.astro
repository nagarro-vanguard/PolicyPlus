---
// The folds under the lenses, opened one at a time (a native `details` group): context, containers and how it runs, connections,
// the components of a domain, data and its owners, the risks the proposal accepts and the alternatives it passed over.
import "../../styles/architecture.css";
import Diagram from "../analysis/Diagram.astro";
import Picture from "../analysis/Picture.astro";
import AnswerList from "../analysis/AnswerList.astro";
import AssumptionList from "../analysis/AssumptionList.astro";
import NoDataState from "../ui/NoDataState.astro";
import { contextModel } from "../../lib/model";
import { copy } from "../../lib/architecture-copy";
import { briefsFor, kindsOf } from "../../lib/figures";
import { kindsOfData } from "../../lib/architecture-owners";
import { analysisCopy } from "../../lib/architecture-folds";
import { compareText, firstSentence, plural } from "../../lib/text";
import { accessWords, answerGroups, kindWords, partKindWords, wordFor } from "../../lib/words";
import type { Architecture, TargetData } from "../../lib/target-types";
import type { Knowledge, System } from "../../lib/types";
export interface Props {
    sys: System;
    know: Knowledge;
    known: ReadonlySet<string>;
    /** The chosen architecture, when there is one. */
    architecture: Architecture | undefined;
    /** The other architectures compared (all of them when none is chosen). */
    alternatives: readonly Architecture[];
    target: TargetData | undefined;
}
const { sys, know, known, architecture, alternatives, target } = Astro.props;
const components = architecture?.components ?? [];
const partName = new Map(know.parts.map((part) => [part.id, part.name]));
const reachedBy = (id: string) => [...Map.groupBy(know.partLinks.filter((link) => link.to === id), (link) => link.from)].map(([from, links]) => ({ part: partName.get(from) ?? "", how: [...new Set(links.map((link) => wordFor(accessWords, link.kind)))].join(", ") })).filter((use) => use.part !== "").toSorted((one, other) => compareText(one.part, other.part));
const outside = sys.externals.toSorted((one, other) => other.links - one.links || compareText(one.name, other.name));
const integrationOf = (id: string) => architecture?.integrations.find((each) => each.need === id);
const actors = [...new Set((target?.journeys ?? []).map((journey) => journey.actor))].filter((actor) => actor !== "");
const answers = {
    built: know.answers.filter((answer) => answer.group === "How it is built inside" && answer.aspect !== "external-systems" && answer.aspect !== "connections"),
    connections: know.answers.filter((answer) => answer.aspect === "external-systems" || answer.aspect === "connections"),
};
const integrationBriefs = briefsFor(kindsOf.connections, sys, know);
const partBriefs = briefsFor(kindsOf.madeOf, sys, know).filter((brief) => brief.kind === "parts");
const kinds = kindsOfData(know, architecture);
const owned = kinds.filter((kind) => kind.owner !== undefined);
const people = sys.entries.person;
const summary = analysisCopy.summaries({ people, outside: outside.length, parts: know.parts.length, containers: architecture?.containers.length ?? 0, components: components.length, domains: architecture?.domains.length ?? 0, kinds: kinds.length, risks: architecture?.risks.length ?? 0, alternatives: alternatives.length });
---
<div class="arch-folds" data-folds>
    <details class="arch-fold" id="context" name="arch-fold" data-fold="context">
        <summary>{copy.architecture.folds.context}</summary>
        <div class="arch-fold-body">
            <p class="arch-note">Who uses it and what it talks to.</p>
            <h3>Today</h3>
            <p>{people > 0 ? `People start ${plural(people, "action")} in the program.` : "No action is started by a person."}{sys.entries.schedule > 0 ? ` A schedule starts ${plural(sys.entries.schedule, "action")}.` : ""}{sys.entries.otherSystem > 0 ? ` Another system starts ${plural(sys.entries.otherSystem, "action")}.` : ""} It reaches {plural(outside.length, "outside system")}.</p>
            <Diagram id="context" titled={false} facts={contextModel(sys).facts} build={(limit) => contextModel(sys, limit).model} known={known} />
            {architecture !== undefined && <Fragment>
                <h3>Modernized</h3>
                <p>{actors.length === 0 ? "The journeys name no one who uses it." : `Used by ${actors.join(", ")}.`} It reaches {plural(architecture.integrations.length, "outside system")}, each through one adapter owned by one domain (see Connections).</p>
            </Fragment>}
        </div>
    </details>
    <details class="arch-fold" id="containers" name="arch-fold" data-fold="containers">
        <summary>{copy.architecture.folds.containers}<span>{summary.containers}</span></summary>
        <div class="arch-fold-body">
            <h3>Today</h3>
            {know.parts.length === 0 ? <NoDataState compact title="No part found" message="The analysis found no part that is built and run. Look at the layers above." /> : <div class="arch-table-wrap wide"><table class="arch-table">
                <thead><tr><th scope="col">Part</th><th scope="col">Kind</th><th scope="col">What it is</th><th scope="col">Built with</th></tr></thead>
                <tbody>{know.parts.map((part) => <tr><th scope="row">{part.name}</th><td>{wordFor(partKindWords, part.kind)}</td><td>{firstSentence(part.purpose)}</td><td>{part.technologies.join(", ")}</td></tr>)}</tbody>
            </table></div>}
            {partBriefs.map((brief) => <Picture brief={brief} sys={sys} knowledge={know} known={known} titled={false} />)}
            <AnswerList answers={know.answers} groups={answerGroups.runs} />
            <h3>What we assumed</h3>
            <AssumptionList assumptions={know.assumptions} />
            {answers.built.length > 0 && <Fragment>
                <h3>How it is built inside</h3>
                <AnswerList answers={answers.built} groups={["How it is built inside"]} flat />
            </Fragment>}
            {architecture !== undefined && <Fragment>
                <h3>Modernized</h3>
                <ul class="arch-parts">
                    {architecture.containers.map((container) => <li><b>{container.name}</b>{container.kind}: {container.tech}. Holds {container.holds.join(", ")}.</li>)}
                </ul>
            </Fragment>}
        </div>
    </details>
    <details class="arch-fold" id="connections" name="arch-fold" data-fold="connections">
        <summary>{copy.architecture.folds.connections}<span>{summary.connections}</span></summary>
        <div class="arch-fold-body">
            {integrationBriefs.map((brief) => <Picture brief={brief} sys={sys} knowledge={know} known={known} titled={false} />)}
            {outside.length === 0 ? <NoDataState compact title="Nothing outside" message="The analysis found no outside system the program reaches." /> : <div class="arch-table-wrap wide"><table class="arch-table">
                <thead><tr><th scope="col">Outside system</th><th scope="col">Kind</th><th scope="col">Today, used by</th>{architecture !== undefined && <th scope="col">Modernized, kept by</th>}</tr></thead>
                <tbody>{outside.map((each) => {
                    const kept = integrationOf(each.id);
                    return <tr>
                        <th scope="row">{each.name}</th>
                        <td>{wordFor(kindWords, each.kind)}</td>
                        <td>{reachedBy(each.id).map((use) => `${use.part}: ${use.how}`).join("; ")}</td>
                        {architecture !== undefined && <td>{kept === undefined ? "Not placed in a domain" : `${kept.domain}. ${firstSentence(kept.how)}`}</td>}
                    </tr>;
                })}</tbody>
            </table></div>}
            {answers.connections.length > 0 && <AnswerList answers={answers.connections} groups={["How it is built inside"]} flat />}
        </div>
    </details>
    {architecture !== undefined && <Fragment>
        <details class="arch-fold" id="components" name="arch-fold" data-fold="components">
            <summary>{copy.architecture.folds.components}<span>{summary.components}</span></summary>
            <div class="arch-fold-body">
                {components.length === 0 ? <NoDataState compact title={copy.architecture.noComponentsTitle} message={copy.architecture.noComponents} /> : architecture.domains.map((domain, at) => {
                    const count = components.filter((component) => component.domain === domain.name).length;
                    return <details class="arch-sub" name="arch-domain" data-domain={at}>
                        <summary>{domain.name}<span>{plural(count, "component")}</span></summary>
                        <p class="arch-note">{firstSentence(domain.concept)}{domain.dependsOn.length > 0 ? ` Relies on ${domain.dependsOn.join(", ")}.` : ""}</p>
                        <ul class="arch-parts" data-components></ul>
                    </details>;
                })}
            </div>
        </details>
        <details class="arch-fold" id="data" name="arch-fold" data-fold="data">
            <summary>{copy.architecture.folds.data}<span>{summary.data}</span></summary>
            <div class="arch-fold-body">
                <p>{owned.length === 0 ? "No kind of data is owned by a domain yet." : `${plural(owned.length, "kind")} of data ${owned.length === 1 ? "has" : "have"} an owner: ${owned.map((kind) => `${kind.name} by ${kind.owner?.domain ?? ""}`).join("; ")}.`}</p>
                <p><a href="data.html">Open the data page</a></p>
            </div>
        </details>
        <details class="arch-fold" id="risks" name="arch-fold" data-fold="risks">
            <summary>{copy.architecture.folds.risks}<span>{summary.risks}</span></summary>
            <div class="arch-fold-body">
                {architecture.risks.length === 0 ? <NoDataState compact title="No risk recorded" message="The proposal records no risk it accepts." /> : <ul class="arch-plain">{architecture.risks.map((risk) => <li>{risk}</li>)}</ul>}
                <p class="arch-note">Cost of the choice: {architecture.tradeoff}</p>
            </div>
        </details>
    </Fragment>}
    {alternatives.length > 0 && <details class="arch-fold" id="alternatives" name="arch-fold" data-fold="alternatives">
        <summary>{copy.architecture.folds.alternatives}<span>{summary.alternatives}</span></summary>
        <div class="arch-fold-body">
            {alternatives.map((variant) => <details class="arch-sub">
                <summary>{variant.name}<span>{plural(variant.domains.length, "domain")}</span></summary>
                <p>{variant.idea}</p>
                <p class="arch-note">Cost: {variant.tradeoff}</p>
                {variant.risks.length > 0 && <ul class="arch-plain">{variant.risks.map((risk) => <li>{risk}</li>)}</ul>}
            </details>)}
        </div>
    </details>}
</div>

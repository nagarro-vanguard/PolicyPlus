---
// The risks as headings: severity, then kind, each with its count and an address in the page; under each heading one row per
// risk (severity chip, the sentence whole, what it touches). No search box and no filter: the global search finds a risk by its
// words, for example `risk:` and a word.
import "../../styles/architecture.css";
import Badge from "../ui/Badge.astro";
import NoDataState from "../ui/NoDataState.astro";
import { copy } from "../../lib/architecture-copy";
import { sentenceOf, riskGroups } from "../../lib/architecture-risks";
import { words } from "../../lib/analysis-copy";
import { severityWords, wordFor } from "../../lib/words";
export interface Props {
    risks: readonly { severity: string; category: string; categoryWords: string; statement: string; href: string; touches: readonly string[]; touchCount: number }[];
}
const { risks } = Astro.props;
const groups = riskGroups(risks);
---
{risks.length === 0 && <NoDataState title={words.risks.noneTitle} message={words.risks.none} />}
{risks.length > 0 && <Fragment>
    <nav class="arch-riskbar" aria-label={copy.risks.nav}>
        {groups.map((group) => <a href={`#${group.id}`}>{wordFor(severityWords, group.severity)} <b>{group.count}</b></a>)}
    </nav>
    <div class="arch-risks">
        {groups.map((group) => <section id={group.id} aria-labelledby={`${group.id}-heading`}>
            <h2 id={`${group.id}-heading`}>{copy.risks.severityHeading(wordFor(severityWords, group.severity), group.count)}</h2>
            {group.kinds.map((kind) => <Fragment>
                <h3 id={kind.id}>{copy.risks.severityHeading(kind.words, kind.risks.length)}</h3>
                <ul class="arch-risk-rows">
                    {kind.risks.map((risk) => <li>
                        <span><Badge kind={risk.severity as "high" | "medium" | "low"} /></span>
                        <span><a href={risk.href}>{sentenceOf(risk.statement)}</a><span class="arch-touch"><span class="visually-hidden">{words.risks.touches}: </span>{risk.touches.length === 0 ? words.risks.touchesNone : risk.touches.join(", ")}{risk.touchCount > risk.touches.length ? ` ${words.risks.more(risk.touchCount - risk.touches.length)}` : ""}</span></span>
                    </li>)}
                </ul>
            </Fragment>)}
        </section>)}
    </div>
</Fragment>}

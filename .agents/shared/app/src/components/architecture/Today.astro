---
// Today: the layers as the parts of one program, then the layers that are project work. The drawing opens in the viewer in the
// Today lens; the list says the same.
import "../../styles/architecture.css";
import { copy } from "../../lib/architecture-copy";
import { firstSentence, plural } from "../../lib/text";
import type { System } from "../../lib/types";
export interface Props {
    sys: System;
}
const { sys } = Astro.props;
const layers = sys.layers.toSorted((one, other) => other.blocks - one.blocks);
const product = layers.filter((layer) => layer.product);
const project = layers.filter((layer) => !layer.product);
---
<div class="arch-block" id="today">
    <h2>Today <small>{plural(product.length, "layer")}</small></h2>
    <div class="arch-drawing" data-lens-only="today" data-drawing="data/architecture-today.json" data-title="Today's layers and the capabilities in them">
        <p class="arch-wait" role="status">{copy.architecture.drawing}</p>
    </div>
    <ul class="arch-parts">
        {product.map((layer) => <li><b>{layer.name}</b><span class="arch-desc">{firstSentence(layer.purpose)}</span></li>)}
    </ul>
    {project.length > 0 && <div class="arch-project-block">
        <h3>{copy.architecture.projectWork}</h3>
        <p class="arch-note">{copy.architecture.projectWorkNote}</p>
        <ul class="arch-parts arch-project">
            {project.map((layer) => <li><b>{layer.name}</b><span class="arch-desc">{firstSentence(layer.purpose)}</span></li>)}
        </ul>
    </div>}
</div>

---
// The three lenses as one control. The page's script shows the block of the pressed one; the address holds it.
import "../../styles/architecture.css";
import { copy } from "../../lib/architecture-copy";
import { lensWords } from "../../lib/architecture-page";
import type { Lens } from "../../lib/architecture-page";
export interface Props {
    lenses: readonly Lens[];
    current: Lens;
}
const { lenses, current } = Astro.props;
---
<div class="arch-lens" role="group" aria-label={copy.architecture.lens}>
    {lenses.map((lens) => <button type="button" data-lens-button={lens} aria-pressed={lens === current}>{lensWords[lens]}</button>)}
</div>

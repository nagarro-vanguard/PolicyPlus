---
// Modernized: the chosen architecture as an idea, the containers it is built as and the domains with how many components each.
import "../../styles/architecture.css";
import { copy } from "../../lib/architecture-copy";
import { plural } from "../../lib/text";
import type { Architecture } from "../../lib/target-types";
export interface Props {
    architecture: Architecture;
}
const { architecture } = Astro.props;
const components = architecture.components ?? [];
const counts = architecture.domains.map((domain) => ({ domain, count: components.filter((component) => component.domain === domain.name).length }));
---
<div class="arch-block" id="modernized">
    <h2>Modernized <small>{plural(architecture.domains.length, "domain")}, {plural(components.length, "component")}</small></h2>
    <div class="arch-drawing" data-lens-only="modernized" data-drawing="data/architecture-modernized.json" data-title="Modernized domains and their components">
        <p class="arch-wait" role="status">{copy.architecture.drawing}</p>
    </div>
    <ul class="arch-parts">
        <li><b>{architecture.name}</b><span class="arch-desc">{architecture.idea}</span></li>
        {architecture.containers.map((container) => <li class="arch-more"><b>{container.name}</b><span class="arch-desc">{container.kind}, holds {plural(container.holds.length, "domain")}</span></li>)}
    </ul>
    <p class="arch-domains">{counts.map(({ domain, count }) => <span><b>{domain.name}</b> {count}</span>)}</p>
</div>

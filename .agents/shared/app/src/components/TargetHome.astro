---
import Page from "../layouts/Page.astro";
import ConfirmBar from "./ConfirmBar.astro";
import { architecturePath, chosenOf, lineagePath, systemPath, taskPath } from "../lib/target-text";
import type { TargetData } from "../lib/target-types";
export interface Props { data: TargetData; }
const { data } = Astro.props;
---
<Page title="The target" lead="How the system should work, decided before it is planned: today's tasks, better ways of doing them, and how the system is built." depth={0} trail={[{ text: "Overview", href: "index.html" }, { text: "Target" }]}>
    <h2>Decisions</h2>
    <ConfirmBar data={data} />
    <h2>Tasks</h2>
    {data.tasks.length === 0 && <p class="note">The as-is stage has not run yet.</p>}
    <table class="data"><thead><tr><th>Task</th><th>Steps today</th><th>Chosen way</th></tr></thead><tbody>
        {data.tasks.map((task) => {
            const chosen = data.gates.journeys.state === "confirmed" ? chosenOf(data.journeys, task) : undefined;
            return <tr><td><a href={`${taskPath(task)}.html`}>{task.outcome}</a></td><td>{task.current.length}</td><td>{chosen ? `${chosen.name}, ${chosen.steps.length} steps` : "not chosen"}</td></tr>;
        })}
    </tbody></table>
    <h2>The system</h2>
    <div class="paths">
        <a class="card" href={`${architecturePath}.html`}><h3>Architecture</h3><span class="sub">{data.architectureVariants.length} ways of cutting the system, compared.</span></a>
        {data.architecture && <a class="card" href={`${systemPath}.html`}><h3>The system and its components</h3><span class="sub">Components, outside systems and data of {data.architecture.name}.</span></a>}
        {data.journeys.length > 0 && <a class="card" href={`${lineagePath}.html`}><h3>Where each step comes from</h3><span class="sub">Each step, the old behaviour it replaces and what carries it.</span></a>}
    </div>
</Page>

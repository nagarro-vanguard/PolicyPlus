---
import Page from "../layouts/Page.astro";
import "../styles/plan.css";
import Details from "./ui/Details.astro";
import Section from "./ui/Section.astro";
import Stat from "./ui/Stat.astro";
import { copy } from "../lib/copy";
import { coverageTree, planHomePath, progressOf, storyPath } from "../lib/plan";
import type { PlanData } from "../lib/plan-data";
import type { ActionLookup } from "../lib/plan-links";
import { plural } from "../lib/text";
import { words } from "../lib/plan-words";
export interface Props { data: PlanData; lookup: ActionLookup; }
const { data, lookup } = Astro.props;
const { plan, ledger } = data;
const root = "../";
const tree = coverageTree(plan);
const progress = progressOf(plan, ledger);
const unplanned = plan.coverage.unplanned.toSorted((one, other) => one.file.localeCompare(other.file) || one.firstLine - other.firstLine);
const noWindow = "Entry points without a window";
// A surface is named in the plan as the code names its window; the analysis knows the screen by a plain name.
const surfaceName = (surface: { name: string; ids: readonly string[] }) =>
    surface.name === noWindow
        ? copy.plan.coverageNoWindow
        : (surface.ids.map((id) => lookup(id)?.screen?.text).find((text) => text !== undefined) ?? surface.name);
const purpose = (id: string) => lookup(id)?.purpose ?? copy.plan.coverageAction;
---
<Page wide title={words.coverageTitle} lead={words.coverageLead} depth={1} trail={[{ text: "Overview", href: `${root}index.html` }, { text: "Modernization plan", href: `${root}${planHomePath}.html` }, { text: words.coverageTitle }]}>
    <div class="pl-panel pl-summary">
        <div class="pl-stats">
            <Stat value={tree.length} unit={words.capabilitiesWord} />
            <Stat value={tree.reduce((sum, each) => sum + each.actions, 0)} unit={words.actionsWord} />
            <Stat value={`${plan.coverage.rulesBuilt} of ${plan.coverage.rulesTotal}`} unit={words.rulesCovered} />
            {progress.merged > 0 && <Stat value={`${progress.rulesBuilt} of ${progress.rulesTotal}`} unit={words.rebuilt} />}
        </div>
    </div>
    <Section title={words.capabilitiesHeading}>
        <div class="pl-stack">{tree.map((capability) => <details class="pl-card pl-cap">
            <summary>
                <span class="pl-titles"><h3>{capability.name}</h3><span class="pl-sub">{words.capabilityLine(capability.surfaces.length, capability.actions, capability.stories)}</span></span>
                {capability.scope !== "carry" && <span class="pl-chip">{copy.plan.scopeWords[capability.scope as keyof typeof copy.plan.scopeWords] ?? capability.scope}</span>}
            </summary>
            <div class="pl-cap-body">{capability.surfaces.map((surface) => <div>
                <h4>{surfaceName(surface)}</h4>
                <ul class="pl-rows">
                    {surface.stories.map((entry) => <li><a href={`${root}${storyPath(entry.story)}.html`}><span class="pl-row-title">{entry.story.title}</span><span class="pl-row-count">{words.actionsCount(entry.actions.length)}</span></a>
                        <ul class="pl-actions-list">{entry.actions.map((action) => <li>{purpose(action.id)}</li>)}</ul></li>)}
                    {surface.without.length > 0 && <li><p class="pl-note">{words.noStory}</p><ul class="pl-actions-list">{surface.without.map((action) => <li>{purpose(action.id)}</li>)}</ul></li>}
                </ul>
            </div>)}</div>
        </details>)}</div>
    </Section>
    <Section title={words.notPlanned}>
        <p class="pl-note">{words.notPlannedNote}</p>
        <Details summary={plural(unplanned.length, "piece of code", "pieces of code")}>
            <div class="table-wrap"><table class="data">
                <thead><tr><th>{copy.plan.unplannedColumns.what}</th><th>{copy.plan.unplannedColumns.file}</th><th>{copy.plan.unplannedColumns.lines}</th></tr></thead>
                <tbody>{unplanned.map((item) => <tr><td><code>{item.what}</code></td><td><code>{item.file}</code></td><td>{item.firstLine}–{item.lastLine}</td></tr>)}</tbody>
            </table></div>
        </Details>
    </Section>
</Page>

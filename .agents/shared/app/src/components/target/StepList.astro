---
// Steps as a compact numbered list: what the person does, what the system does, how sure we are, and what became of it.
import "../../styles/target.css";
import Badge from "../ui/Badge.astro";
import Details from "../ui/Details.astro";
export interface Item {
    text: string;
    sub?: string | undefined;
    /** `sure` or `inferred`, as the records say. */
    confidence?: string | undefined;
    /** How a step changed: merged, kept, new. */
    tag?: string | undefined;
    /** A line under the step, such as the steps it takes the place of. */
    meta?: string | undefined;
    /** The person's verdict on the step and the note with it. */
    mark?: { verdict: string; note?: string | undefined } | undefined;
}
export interface Props {
    items: readonly Item[];
    label: string;
    /** When given, what the system does at each step is folded under this summary instead of shown under each step. */
    foldSub?: string;
}
const { items, label, foldSub } = Astro.props;
const subs = foldSub === undefined ? [] : items.flatMap((item, at) => (item.sub === undefined || item.sub === "" ? [] : [{ at: at + 1, text: item.sub }]));
const kind = (confidence: string | undefined) => (confidence === undefined ? undefined : confidence === "sure" ? "stated" : confidence === "assumed" ? "assumed" : "inferred");
const word = (confidence: string | undefined) => (confidence === "sure" ? "Stated" : confidence === "assumed" ? "Assumed" : "Inferred");
const verdictKind = { hurts: "high", unused: "medium", wrong: "high", correct: "stated", kept: "low" } as const;
---
<ol class="tx-steps" aria-label={label}>
    {items.map((item, at) => <li>
        <span class="tx-n">{at + 1}.</span>
        <p class="tx-step-text">{item.text}</p>
        <span class="tx-chips">
            {item.tag !== undefined && <span class="tx-tag">{item.tag}</span>}
            {kind(item.confidence) !== undefined && <Badge kind={kind(item.confidence) ?? "neutral"} label={word(item.confidence)} />}
            {item.mark !== undefined && <Badge kind={verdictKind[item.mark.verdict as keyof typeof verdictKind] ?? "neutral"} label={`You marked: ${item.mark.verdict}`} />}
        </span>
        {foldSub === undefined && item.sub !== undefined && item.sub !== "" && <p class="tx-sub">{item.sub}</p>}
        {item.mark?.note !== undefined && <p class="tx-sub">{item.mark.note}</p>}
        {item.meta !== undefined && item.meta !== "" && <p class="tx-meta">{item.meta}</p>}
    </li>)}
</ol>
{subs.length > 0 && <Details summary={foldSub ?? ""}><ol class="tx-plain tx-subs">{subs.map((sub) => <li value={sub.at}>{sub.text}</li>)}</ol></Details>}

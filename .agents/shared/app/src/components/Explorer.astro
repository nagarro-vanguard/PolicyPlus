---
import type { NodeView } from "../case/view";
import { heading } from "../case/format";
import { copy } from "../lib/copy";
import Rows from "./Rows.astro";
// One node of the hierarchy, the same anatomy at every level: what kind of thing it is, at most three facts, what checks
// it, its diagrams as text, the next level as rows, folds for the rest, links to the same thing elsewhere, the way up,
// back and on, and the text a reader can hand to an assistant. Every count comes from the case's numbers table with its
// scope as the explanation; every name and sentence is the analysis's own.
export interface Props {
    view: NodeView;
    root: string;
}
const { view, root } = Astro.props;
const href = (address: string) => `${root}${address}`;
---
<div class="explorer" data-node-view>
    <p class="node-noun"><span class="badge" data-written-by="agent">{heading(view.noun.one)}</span></p>
    {view.facts.length > 0 && <ul class="facts" aria-label={copy.explorer.facts}>
        {view.facts.map((fact) => <li title={fact.scope} data-written-by="app">{fact.text}</li>)}
        {view.tests !== null && <li title={view.tests.scope} data-written-by="app">{copy.explorer.checkedBy(view.tests.text)}</li>}
    </ul>}
    {view.diagrams.map((diagram) => <figure class="sec diagram-text" data-diagram={diagram.key}>
        <figcaption><h2 data-written-by="agent">{diagram.title}</h2>{diagram.question !== null && <p class="note" data-written-by="agent">{diagram.question}</p>}</figcaption>
        <details class="fold-line">
            <summary data-written-by="app">{copy.explorer.diagramText}</summary>
            <div class="fold-body">
                <ul class="diagram-lines">{diagram.text.map((line) => <li data-written-by="agent">{line}</li>)}</ul>
                {diagram.legend.length > 0 && <Fragment>
                    <h3 data-written-by="app">{copy.explorer.diagramLegend}</h3>
                    <ul>{diagram.legend.map((words) => <li data-written-by="agent">{words}</li>)}</ul>
                </Fragment>}
            </div>
        </details>
    </figure>)}
    {view.children.rows.length > 0 && <section class="sec" aria-label={view.children.heading}>
        <h2 data-written-by="agent">{view.children.heading}</h2>
        <Rows rows={view.children.rows} root={root} />
    </section>}
    {view.folds.length > 0 && <div class="folds">
        {view.folds.map((fold) => <details class="fold-line" data-fold={fold.kind}>
            <summary data-written-by="app">{fold.title}</summary>
            <div class="fold-body"><Rows rows={fold.rows} root={root} /></div>
        </details>)}
    </div>}
    {view.lateral.map((group) => <section class="sec" aria-label={group.label}>
        <h2 data-written-by="app">{group.label}</h2>
        <div class="list">{group.links.map((each) => <a class="row" href={href(each.href)}>
            <span class="t" data-written-by="agent">{each.name}</span>
            {each.count !== undefined && <span class="r" title={each.count.scope} data-written-by="app">{each.count.text}</span>}
        </a>)}</div>
    </section>)}
    {(view.up !== null || view.prev !== null || view.next !== null) && <nav class="pager" aria-label={copy.explorer.up}>
        {view.prev !== null && <a rel="prev" href={href(view.prev.href)}><span class="pager-word" data-written-by="app">{copy.explorer.previous}</span><span data-written-by="agent">{view.prev.name}</span></a>}
        {view.up !== null && <a class="pager-up" href={href(view.up.href)}><span class="pager-word" data-written-by="app">{copy.explorer.up}</span><span data-written-by="agent">{view.up.name}</span></a>}
        {view.next !== null && <a rel="next" href={href(view.next.href)}><span class="pager-word" data-written-by="app">{copy.explorer.next}</span><span data-written-by="agent">{view.next.name}</span></a>}
    </nav>}
    {view.assistant !== null && <div class="assistant" data-for-assistant>
        <button type="button" class="btn" data-assistant-file={href(view.assistant.file)} data-copied={copy.site.copied}><span data-label>{copy.explorer.copyForAssistant}</span> <span class="muted">{copy.explorer.size(view.assistant.kilobytes)}</span></button>
        {view.assistant.fuller !== null && <p class="note">{copy.explorer.fullerText} <code>{view.assistant.fuller}</code></p>}
        <textarea class="assistant-fallback" readonly hidden aria-label={copy.explorer.forAssistant}></textarea>
    </div>}
</div>

---
import Page from "../layouts/Page.astro";
import "../styles/plan.css";
import Button from "./ui/Button.astro";
import Details from "./ui/Details.astro";
import Section from "./ui/Section.astro";
import Stat from "./ui/Stat.astro";
import OrderStrip from "./plan/OrderStrip.astro";
import PhaseCard from "./plan/PhaseCard.astro";
import { coveragePath, epicPath, epicsInOrder, foundationPath, progressOf, storiesInOrder, storyPath } from "../lib/plan";
import { movedStatuses, phaseCards, stateOfStatus } from "../lib/plan-view";
import type { PlanData } from "../lib/plan-data";
import { words } from "../lib/plan-words";
export interface Props { data: PlanData; }
const { data } = Astro.props;
const { plan, ledger } = data;
const progress = progressOf(plan, ledger);
const cards = phaseCards(plan, ledger);
const moved = movedStatuses(progress.byStatus);
const firstEpic = epicsInOrder(plan)[0];
const firstStory = storiesInOrder(plan)[0];
const date = ledger?.reviewed === undefined ? undefined : ledger.reviewed.slice(0, 10);
---
<Page wide title={words.title} lead={words.lead} depth={0} trail={[{ text: "Overview", href: "index.html" }, { text: words.title }]}>
    <div class="pl-panel pl-summary">
        <div class="pl-stats">
            <Stat value={plan.phases.length} unit="phases" />
            <Stat value={plan.epics.length} unit="epics" />
            <Stat value={plan.stories.length} unit="stories" />
            <Stat value={`${plan.coverage.rulesBuilt} of ${plan.coverage.rulesTotal}`} unit={words.rulesCovered} />
        </div>
        <div class="pl-progress">
            <div class="pl-caption"><span>{progress.merged === 0 ? words.noneMerged : words.merged(progress.merged)}</span><span>{date === undefined ? words.notReviewed : words.reviewed(date)}</span></div>
            <div class="pl-bar" role="img" aria-label={words.progress(progress.merged, progress.stories)}>
                {moved.map((each) => <i data-state={stateOfStatus(each.status)} style={`width:${(each.count / progress.stories) * 100}%`}></i>)}
            </div>
            {moved.length > 0 && <ul class="pl-legend">{moved.map((each) => <li data-state={stateOfStatus(each.status)}>{each.count} {each.status}</li>)}</ul>}
        </div>
        <div class="pl-ordered">
            <div class="pl-caption"><span>{words.order}</span><span>{words.orderNote}</span></div>
            <OrderStrip phases={cards} />
        </div>
    </div>
    <div class="pl-actions">
        {firstEpic && <Button variant="primary" href={`${epicPath(firstEpic)}.html`}>{words.start}</Button>}
    </div>
    <Details summary={words.howTitle}>
        <ol class="pl-steps">
            <li><strong>{words.howEpics}</strong> {words.howEpicsNote}</li>
            <li><strong>{words.howScaffold}</strong> {words.howScaffoldNote} <a href={`${foundationPath}.html#scaffold`}>Open it</a></li>
            <li><strong>{words.howDeliver}</strong> {words.howDeliverNote} {firstStory && <a href={`${storyPath(firstStory)}.html`}>Open the first</a>}</li>
        </ol>
    </Details>
    <Section title={words.phases}>
        <ol class="pl-cards">{cards.map((phase) => <PhaseCard phase={phase} />)}</ol>
    </Section>
    <Section title="Foundation and coverage">
        <ul class="pl-links">
            <li><a class="pl-panel pl-link" href={`${foundationPath}.html`}><h3>{words.foundationTitle}</h3><p class="pl-sub">{words.foundationLine(plan.layers.length, plan.decisions.length)}</p></a></li>
            <li><a class="pl-panel pl-link" href={`${coveragePath}.html`}><h3>{words.coverageTitle}</h3><p class="pl-sub">{words.coverageLine(plan.coverage.unplanned.length)}</p></a></li>
        </ul>
    </Section>
</Page>

---
import Page from "../layouts/Page.astro";
import "../styles/plan.css";
import Section from "./ui/Section.astro";
import PromptFold from "./plan/PromptFold.astro";
import PlanState from "./plan/PlanState.astro";
import StoryCard from "./plan/StoryCard.astro";
import { epicPath, epicsInOrder, planHomePath, storiesOfEpic } from "../lib/plan";
import { epicImplements, epicNeeds, epicPhases, epicState, runsOf, stateWords } from "../lib/plan-view";
import type { PlanData } from "../lib/plan-data";
import { words } from "../lib/plan-words";
export interface Props { data: PlanData; epicKey: string; }
const { data, epicKey } = Astro.props;
const { plan, prompts, ledger } = data;
const epic = plan.epics.find((each) => each.key === epicKey);
if (epic === undefined) throw new Error("no such epic");
const root = "../../";
const needs = epicNeeds(plan, epic);
const stories = storiesOfEpic(plan, epic);
const phases = epicPhases(plan, epic);
const implemented = epicImplements(plan, epic);
const state = epicState(plan, ledger, epic);
const prompt = prompts.epics[epic.key] ?? "";
---
<Page wide title={epic.title} lead={epic.outcome} depth={2} trail={[{ text: "Overview", href: `${root}index.html` }, { text: "Modernization plan", href: `${root}${planHomePath}.html` }, { text: epic.title }]}>
    <p class="pl-meta">
        <PlanState state={state} label={stateWords[state]} />
        <span>{words.epicOf(epic.sequence, epicsInOrder(plan).length)}</span>
        <span>{words.phaseWord(runsOf(phases), phases.length > 1)}</span>
        <span>{epic.kind}</span>
        {implemented.length > 0 && <span>{implemented.join(", ")}</span>}
        <span>{words.stories(stories.length)}</span>
    </p>
    {needs.length > 0 && <p class="pl-line"><span class="pl-k">{words.createAfter}</span>{needs.map((each) => <a class="pl-chip pl-chip-wrap" href={`${root}${epicPath(each)}.html`}>{each.title}</a>)}</p>}
    <Section title={words.storiesHeading}>
        <ol class="pl-grid">{stories.map((story) => <StoryCard story={story} ledger={ledger} root={root} phase={phases.length > 1 ? story.phase : undefined} />)}</ol>
    </Section>
    <PromptFold summary={words.createEpic} note={words.createEpicNote} text={prompt} />
</Page>

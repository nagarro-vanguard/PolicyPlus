---
import "../styles/app.css";
import { ClientRouter } from "astro:transitions";
import { copy } from "../lib/copy";
import { siteOf } from "../case/site";
import { rootOf } from "../case/routes";
import { sectionOfPage } from "../case/sections";
import Icon from "../components/ui/Icon.astro";
import Kbd from "../components/ui/Kbd.astro";
import ThemeControl from "../components/ui/ThemeControl.astro";
export interface Props {
    title: string;
    lead?: string;
    /** The page's file below the site's root (`index.html`, `capability/keeping-records.html`). */
    page: string;
    /** Who wrote the heading and the lead: the analysis (`agent`) or the app itself (`app`). */
    writtenBy?: "agent" | "app";
    /** The page holds a table or a drawing that needs the wider column. */
    wide?: boolean;
}
const { title, lead = "", page, writtenBy = "app", wide = false } = Astro.props;
const root = rootOf(page);
const site = await siteOf();
const current = sectionOfPage(page, site.sections);
---
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <ClientRouter fallback="swap" />
    <script is:inline>
        try { var t = localStorage.getItem("theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
</head>
<body data-root={root} data-page={page}>
    <a class="skip" href="#main" data-written-by="app">{copy.site.skip}</a>
    <div class="app">
        <nav id="sidebar" class="side" aria-label={copy.site.sections} data-sidebar transition:persist="sidebar">
            <a class="brand" href={`${root}index.html`} data-astro-prefetch="hover" data-written-by="agent"><i aria-hidden="true"></i>{site.name}</a>
            <h2 class="side-title" data-written-by="app">{copy.site.sectionsTitle}</h2>
            {site.nav.map((section) => <a href={`${root}${section.href}`} data-section={section.id} data-astro-prefetch="hover" data-written-by="app" aria-current={current === section.id ? (section.href === page ? "page" : "true") : undefined}>{section.label}</a>)}
        </nav>
        <div class="main">
            <header class="top">
                <button type="button" class="menu-button" aria-controls="sidebar" aria-expanded="false" data-menu-toggle>
                    <Icon name="menu" /><span class="visually-hidden" data-written-by="app">{copy.site.menu}</span>
                </button>
                <button type="button" class="palette-open" data-palette-open aria-keyshortcuts="/ Control+K Meta+K" aria-haspopup="dialog">
                    <Icon name="search" /><span class="palette-open-text" data-written-by="app">{copy.site.searchOpen}</span><Kbd><span data-kbd>⌘K</span></Kbd>
                </button>
                <ThemeControl />
            </header>
            <main id="main" class="page" tabindex="-1" data-wide={wide ? "true" : undefined}>
                <slot name="trail" />
                <div class="opening">
                    <h1 data-written-by={writtenBy}>{title}</h1>
                    {lead !== "" && <p class="lead" data-written-by={writtenBy}>{lead}</p>}
                </div>
                <slot />
            </main>
        </div>
    </div>
    <dialog id="palette" class="palette" aria-label={copy.site.search} data-palette>
        <form method="dialog" class="palette-form" role="search">
            <label class="visually-hidden" for="palette-input" data-written-by="app">{copy.site.search}</label>
            <input id="palette-input" type="text" role="combobox" aria-expanded="true" aria-controls="palette-list" aria-autocomplete="list" autocomplete="off" spellcheck="false" placeholder={copy.site.searchHint} />
            <ul id="palette-list" class="palette-list" role="listbox" aria-label={copy.site.results}></ul>
            <p class="palette-help" id="palette-help" data-written-by="app">{copy.site.searchHelp}</p>
        </form>
    </dialog>
    <script type="application/json" id="copy-strings" set:html={JSON.stringify({ copied: copy.site.copiedAnnounce, noMatch: copy.site.noMatch, copyFailed: copy.site.copyFailed, loading: copy.explorer.loading, failed: copy.explorer.failed, checkedBy: copy.explorer.checkedBy("").trim(), trail: copy.site.trail })}></script>
    <div id="announce" class="visually-hidden" aria-live="polite"></div>
    <script is:inline data-astro-rerun src={`${root}site.js`}></script>
    <script>import "../scripts/shell.ts";</script>
</body>
</html>

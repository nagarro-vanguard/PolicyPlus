---
import "../styles/app.css";
import { ClientRouter } from "astro:transitions";
import { copy, relationLabels } from "../lib/copy";
import { siteOf } from "../case/site";
import { rootOf } from "../case/routes";
import { sectionOfPage } from "../case/sections";
import { SideNav } from "../components/shell/SideNav";
import { MobileNav } from "../components/shell/MobileNav";
import { SearchButton, ThemeControl } from "../components/shell/TopBar";
import { Palette } from "../components/shell/Palette";
import { ErrorState } from "@continuum/ui/components/error-state";
import { PageHeader, type PageAssistant } from "../components/shell/PageHeader";
import { ContentsFold, ContentsRail, contentsFrom } from "../components/shell/Contents";
import { DetailDrawer } from "../components/DetailDrawer";
import type { CountView } from "../case/format";
import { pageHeadings } from "../lib/headings";// The frame of every page, built from the design system's components (vendor/ui) and rendered to HTML at build time.
// The islands, the only components that ship a script, are listed here and nowhere else:
//   MobileNav, `client:media` below Finch's `md`: the sheet that holds the menu on a narrow screen.
// Everything else that moves (search, copy for an assistant, the drawer of an action or rule at `#<key>`, the list of the
// page's headings, the theme) is the page's own small script, src/scripts/shell.ts, src/scripts/contents.ts and
// public/site.js, with no framework.
// Every page opens the same way (PageHeader): its kind, title, one sentence and its actions at the top right, then its
// facts. A page of four or more headings lists them (Contents): a rail beside it from 1280 pixels, a fold at its top below. After the build the offline packager
// (scripts/package/) turns every script into a classic one, adds the page's Content-Security-Policy and moves repeated
// class lists into one shared stylesheet, so the folder works from `file://` and from any subfolder of a site.
export interface Props {
    title: string;
    lead?: string;
    /** The page's file below the site's root (`index.html`, `capability/keeping-records.html`). */
    page: string;
    /** Who wrote the heading and the lead: the analysis (`agent`) or the app itself (`app`). */
    writtenBy?: "agent" | "app";
    /** The page holds a table or a drawing that needs the wider column. */
    wide?: boolean;
    /** What kind of thing the page is about, when it is one of many (the case's noun). */
    label?: string;
    /** The page's few facts, said under its title. */
    facts?: { facts: readonly CountView[]; tests: CountView | null };
    /** The page's text for a reader's assistant, when it has one. */
    assistant?: PageAssistant | null;
    /** The page opens actions and rules in the drawer beside it. */
    drawer?: boolean;
}
const { title, lead = "", page, writtenBy = "app", wide = false, label, facts, assistant = null, drawer = false } = Astro.props;
const content = pageHeadings(await Astro.slots.render("default"));
const listed = content.entries.length >= contentsFrom ? content.entries : [];
const root = rootOf(page);
const site = await siteOf();
const current = sectionOfPage(page, site.sections);
const nav = {
    name: site.name,
    root,
    sections: site.nav.map((section) => ({
        id: section.id,
        label: section.label,
        href: section.href,
        current: current === section.id ? (section.href === page ? ("page" as const) : ("true" as const)) : undefined,
    })),
    words: { sections: copy.site.sections, sectionsTitle: copy.site.sectionsTitle },
};
---
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <link rel="icon" href="data:," />
    <ClientRouter fallback="swap" />
    <script is:inline>
        try { var t = localStorage.getItem("theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; } catch (e) {}
        // Opened from a file, the router cannot read the next page: links load pages the plain way.
        if (location.protocol === "file:") { var vt = document.querySelector('meta[name="astro-view-transitions-enabled"]'); if (vt) vt.remove(); }
    </script>
</head>
<body data-root={root} data-page={page}>
    <a href="#main" class="sr-only z-50 rounded-control border border-input bg-popover px-spacing-lg py-spacing-xs text-popover-foreground focus:not-sr-only focus:fixed focus:start-spacing-md focus:top-spacing-md" data-written-by="app">{copy.site.skip}</a>
    <div class="flex min-h-svh">
        <SideNav {...nav} />
        <div class="flex min-w-0 flex-1 flex-col">
            <header class="sticky top-0 z-20 flex h-12 items-center gap-spacing-md border-b border-border bg-background px-spacing-xxl">
                <MobileNav client:media="(max-width: 904px)" {...nav} menu={copy.site.menu} />
                <SearchButton label={copy.site.searchOpen} />
                <div class="ms-auto shrink-0"><ThemeControl /></div>
            </header>
            <div class="flex w-full min-w-0 justify-center gap-spacing-xl">
                <main id="main" tabindex="-1" class:list={["flex w-full min-w-0 flex-col gap-spacing-4xl px-spacing-xxl pt-spacing-4xl pb-spacing-5xl md:px-spacing-5xl", wide ? "max-w-wide" : "max-w-column"]} data-wide={wide ? "true" : undefined}>
                    <div id="page-error" hidden data-written-by="app">
                        <ErrorState compact title={copy.site.pageErrorTitle} message={copy.site.pageError} />
                    </div>
                    <slot name="trail" />
                    <PageHeader label={label} title={title} summary={lead === "" ? undefined : lead} writtenBy={writtenBy} assistant={assistant} facts={facts} />
                    {listed.length === 0 ? null : <ContentsFold entries={listed} />}
                    <Fragment set:html={content.html} />
                </main>
                {listed.length === 0 ? null : <ContentsRail entries={listed} />}
            </div>
        </div>
    </div>
    <Palette words={{ search: copy.site.search, searchHint: copy.site.searchHint, results: copy.site.results, searchHelp: copy.site.searchHelp }} />
    <script type="application/json" id="copy-strings" set:html={JSON.stringify({ copied: copy.site.copiedAnnounce, noMatch: copy.site.noMatch, copyFailed: copy.site.copyFailed, loading: copy.explorer.loading, failed: copy.explorer.failed, checkedBy: copy.explorer.checkedBy("").trim(), trail: copy.site.trail, previous: copy.explorer.previous, next: copy.explorer.next, detailPager: copy.explorer.detailPager, livesIn: relationLabels.livesIn, reliedOn: copy.rules.reliedOn, ruleStatus: copy.rules.status })}></script>
    {drawer ? <DetailDrawer /> : null}
    <div id="announce" class="sr-only" aria-live="polite"></div>
    <script is:inline data-astro-rerun src={`${root}site.js`}></script>
    <script>import "../scripts/shell.ts"; import "../scripts/contents.ts";</script>
</body>
</html>

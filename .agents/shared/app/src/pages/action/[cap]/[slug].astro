---
// An action: one thing a person can do. Its sentence is the title; below it the layers it passes through, then the business
// rules along the way as links to the one page where each is written (its layer's).
import Page from "../../../layouts/Page.astro";
import Section from "../../../components/ui/Section.astro";
import NoDataState from "../../../components/ui/NoDataState.astro";
import EvidenceChip from "../../../components/ui/EvidenceChip.astro";
import Meta from "../../../components/analysis/Meta.astro";
import Chain from "../../../components/analysis/Chain.astro";
import UsedIn from "../../../components/journey/UsedIn.astro";
import { journeyModel, linksTo } from "../../../lib/journeys";
import RuleLinks from "../../../components/analysis/RuleLinks.astro";
import { capabilities, pathOf, screenHref, slugs, system } from "../../../lib/payloads";
import { rulesByLayer } from "../../../lib/analysis";
import { words } from "../../../lib/analysis-copy";
import { copy } from "../../../lib/copy";
import { titleOf } from "../../../lib/derive";
import { startedWords, wordFor } from "../../../lib/words";
import { where } from "../../../lib/text";

export async function getStaticPaths() {
    const all = await capabilities();
    const addresses = await slugs();
    return all.flatMap((cap) =>
        cap.layers.flatMap((layer) =>
            layer.actions.map((action) => ({
                params: { cap: addresses.capability(cap.capability.id), slug: addresses.action(cap.capability.id, action.id) },
                props: { cid: cap.capability.id, aid: action.id },
            })),
        ),
    );
}
const { cid, aid } = Astro.props;
const sys = await system();
const addresses = await slugs();
const cap = (await capabilities()).find((each) => each.capability.id === cid);
const owner = cap?.layers.find((layer) => layer.actions.some((action) => action.id === aid));
const action = owner?.actions.find((each) => each.id === aid);
if (cap === undefined || action === undefined) throw new Error("no such action");
const screen = sys.screens.find((each) => each.actionIds.includes(action.id));
const capSlug = addresses.capability(cid);
const used = linksTo((await journeyModel()).usingAction(aid), 2);
const steps = pathOf(cap, action);
const groups = rulesByLayer(cap, steps, action.rules);
const ruleTotal = groups.reduce((sum, group) => sum + group.rules.length, 0);
const layerHref = (layer: { id: string }) => `../../layer/${capSlug}/${addresses.layer(cid, layer.id)}.html`;
const trail = [{ text: copy.site.home, href: "../../index.html" }, { text: cap.capability.name, href: `../../capability/${capSlug}.html` }, ...(screen ? [{ text: screen.name, href: screenHref("../../", screen.key) }] : action.screen !== "" ? [{ text: action.screen }] : []), { text: titleOf(action.purpose) }];
---
<Page title={titleOf(action.purpose)} depth={2} brief={action.context.text} trail={trail}>
    <Meta facts={[words.action.startedBy(wordFor(startedWords, action.startedBy)), { value: ruleTotal, unit: ruleTotal === 1 ? "business rule" : "business rules" }]}>
        <li>{words.action.builtFrom}&nbsp;<EvidenceChip place={where(action.place)} /></li>
    </Meta>
    <UsedIn links={used} />
    <Section title={words.action.passes} id="path">
        {steps.length === 0
            ? <NoDataState compact title={words.action.noPathTitle} message={words.action.noPath} />
            : <Fragment>
                <Chain label={words.action.passes} steps={steps.map((layer) => ({ text: layer.name, href: layerHref(layer) }))} />
                <p class="a-note">{words.action.passesNote}</p>
            </Fragment>}
    </Section>
    <Section title={words.action.rules(ruleTotal)} id="rules">
        <RuleLinks groups={groups} layerHref={layerHref} action={addresses.action(cid, aid)} />
    </Section>
</Page>

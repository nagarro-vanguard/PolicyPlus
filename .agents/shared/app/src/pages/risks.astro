---
// Every risk, grouped by severity and then by kind as headings with counts. No search box and no filter chips.
import Page from "../layouts/Page.astro";
import RiskGroups from "../components/architecture/RiskGroups.astro";
import Meta from "../components/analysis/Meta.astro";
import { knowledge, slugs, system } from "../lib/payloads";
import { risksInOrder, screensOfRisk } from "../lib/analysis";
import { copy } from "../lib/copy";
import { severityCounts } from "../lib/risks";

const know = await knowledge();
const sys = await system();
const addresses = await slugs();
const counts = severityCounts(know.risks);
const rows = risksInOrder(know.risks).map((risk) => {
    const screens = screensOfRisk(sys, risk);
    const names = [...risk.places.capabilities.map((place) => place.name), ...(risk.places.capabilities.length === 0 ? screens.map((screen) => screen.name) : [])];
    return { severity: risk.severity, category: risk.category, categoryWords: risk.categoryWords, statement: risk.statement, href: `risk/${addresses.risk(risk.id)}.html`, touches: names.slice(0, 2), touchCount: names.length };
});
const facts = [{ value: know.risks.length, unit: know.risks.length === 1 ? "risk" : "risks" }, ...(["high", "medium", "low"] as const).filter((level) => counts[level] > 0).map((level) => ({ value: counts[level], unit: level }))];
---
<Page wide title={copy.risks.title} lead={copy.risks.lead}>
    <Meta facts={facts}>
        <li><a href="architecture.html#lens=today&fold=containers">{copy.risks.assumptionsLink}</a></li>
    </Meta>
    <RiskGroups risks={rows} />
</Page>

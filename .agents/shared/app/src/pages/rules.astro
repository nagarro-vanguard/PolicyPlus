---
// The rules reference: every business rule once, drawn in the browser from its data file a screenful at a time. The sentence is
// the rule as the code decides it; its place is a chip that copies it, and its layer and capability say where it is read.
import "../styles/journey.css";
import Page from "../layouts/Page.astro";
import Skeleton from "../components/ui/Skeleton.astro";
import { capabilities, slugs } from "../lib/payloads";
import { ruleLines } from "../lib/rules-data";
import { journeyCopy } from "../lib/journey-copy";

const total = ruleLines(await capabilities(), await slugs()).length;
const words = journeyCopy.rules;
---
<Page title={words.title} lead={words.lead(total)} wide trail={[{ text: "Overview", href: "index.html" }, { text: words.title }]}>
    <div data-rules-page data-facet={words.facet}>
        <Skeleton lines={6} />
        <noscript><p class="note">This page is drawn in the browser from its data file. Turn on scripts to read it.</p></noscript>
    </div>
    <script>import "../scripts/rules-page.ts";</script>
</Page>

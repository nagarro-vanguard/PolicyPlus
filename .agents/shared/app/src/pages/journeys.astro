---
// The journeys: what people get done with the system, grouped by area, one row each with its outcome, its steps today and as
// proposed, and where it stands. No filter: the search finds a journey by its words.
import "../styles/journey.css";
import Page from "../layouts/Page.astro";
import Badge from "../components/ui/Badge.astro";
import Section from "../components/ui/Section.astro";
import NoDataState from "../components/ui/NoDataState.astro";
import { journeyModel } from "../lib/journeys";
import { groupByArea } from "../lib/journey-join";
import { journeyCopy } from "../lib/journey-copy";
import { titleOf } from "../lib/derive";

const { journeys } = await journeyModel();
const groups = groupByArea(journeys);
const words = journeyCopy.list;
const proposed = journeys.filter((journey) => journey.way !== undefined).length;
const kind = { decided: "stated", proposed: "medium", "today only": "neutral" } as const;
---
<Page title={words.title} lead={journeys.length === 0 ? "" : words.lead(journeys.length, groups.length, proposed)} trail={[{ text: "Overview", href: "index.html" }, { text: words.title }]}>
    {journeys.length === 0 && <NoDataState title={words.empty.title} message={words.empty.message} />}
    {groups.map((group) => <Section title={group.name} id={group.id === "" ? "other" : group.id.replace(/^capabilitygroup-/, "")}>
        <div class="list">
            {group.journeys.map((journey) => <a class="row jr-item" href={`journey/${journey.slug}.html`} data-astro-prefetch="hover">
                <span class="t">{titleOf(journey.today.outcome)}</span>
                <span class="r">{words.steps(journey.today.current.length, journey.way?.steps.length)} <Badge kind={kind[journey.status]} label={words.status[journey.status]} /></span>
            </a>)}
        </div>
    </Section>)}
</Page>

---
import Page from "../layouts/Page.astro";
import { Overview } from "../components/Overview";
import { caseData } from "../case/data";
import { theCase } from "../case/loader";
import { siteOf } from "../case/site";
import { viewOf } from "../case/view";
// The home page: what the system is, the goals of the work as the people who asked for it wrote them ("Not provided"
// when they wrote none), the first level of the hierarchy, and the way into the reference.
const data = await caseData();
const view = viewOf("overview", data);
const kase = theCase();
const brief = kase.has("brief.json") ? (kase.json("brief.json") as { goals: { provided: boolean; text: string | null; items?: { number: number; node: string; label: string; text: string; summary: "considered" | "missing" | "stale" }[] } }) : null;
const site = await siteOf();
const reference = site.nav.find((section) => section.id === "reference");
const goalsSection = site.nav.find((section) => section.id === "goals");
---
<Page title={view.name} lead={view.summary} page="index.html" writtenBy="agent" facts={{ facts: view.facts, tests: null }}>
    <Overview view={view} goals={brief === null ? null : brief.goals} goalsHref={goalsSection === undefined ? null : `./${goalsSection.href}`} reference={reference === undefined ? null : reference.href} />
</Page>

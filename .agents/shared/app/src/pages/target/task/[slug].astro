---
// A task of the earlier design is now a journey: this sends the reader to its page. Built only with a target.
import Redirect from "../../../components/architecture/Redirect.astro";
import { journeyRedirects } from "../../../lib/journey-redirects";
import { hasTarget, targetData } from "../../../lib/target-data";

export function getStaticPaths() {
    if (!hasTarget()) return [];
    return journeyRedirects(targetData())
        .filter((each) => each.from.startsWith("target/task/"))
        .map((redirect) => ({ params: { slug: redirect.from.slice("target/task/".length) }, props: { redirect } }));
}
const { redirect } = Astro.props;
---
<Redirect redirect={redirect} />

---
// The data page of a journey moved into the journey page: this sends the reader to its data.
import Redirect from "../../../components/architecture/Redirect.astro";
import { targetRedirects } from "../../../lib/architecture-redirects";
import { hasTarget, targetData } from "../../../lib/target-data";

export function getStaticPaths() {
    if (!hasTarget()) return [];
    return targetRedirects(targetData())
        .filter((each) => each.from.startsWith("target/erd/"))
        .map((redirect) => ({ params: { slug: redirect.from.slice("target/erd/".length) }, props: { redirect } }));
}
const { redirect } = Astro.props;
---
<Redirect redirect={redirect} />

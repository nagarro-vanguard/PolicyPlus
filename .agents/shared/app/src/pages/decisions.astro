---
// The four confirmations, in order, each with where it stands, one sentence on what it decided and the way to its review page.
// Built only when there is a target to decide on.
import "../styles/target.css";
import Page from "../layouts/Page.astro";
import Section from "../components/ui/Section.astro";
import NoDataState from "../components/ui/NoDataState.astro";
import GateRow from "../components/target/GateRow.astro";
import { gates } from "../lib/confirmation";
import { journeyCopy } from "../lib/journey-copy";
import { hasTarget, targetData } from "../lib/target-data";

const data = hasTarget() ? targetData() : undefined;
const words = journeyCopy.decisions;
---
<Page title={words.title} lead={words.lead} trail={[{ text: "Overview", href: "index.html" }, { text: words.title }]}>
    {data === undefined
        ? <NoDataState title={words.none.title} message={words.none.message} />
        : <Section title="In order" id="decisions">
            <ol class="tx-rows" aria-label="The four decisions, in order">
                {gates.map((gate) => <GateRow gate={gate} data={data} />)}
            </ol>
        </Section>}
</Page>

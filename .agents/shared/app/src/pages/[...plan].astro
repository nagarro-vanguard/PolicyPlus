---
// The pages of a modernization plan, one route for all five kinds, so a build without a plan makes none of them:
// plan.html, plan/foundation.html, plan/coverage.html, plan/epic/<order>-<title>.html, plan/story/<order>-<title>.html.
import PlanHome from "../components/PlanHome.astro";
import PlanEpic from "../components/PlanEpic.astro";
import PlanStory from "../components/PlanStory.astro";
import PlanFoundation from "../components/PlanFoundation.astro";
import PlanCoverage from "../components/PlanCoverage.astro";
import { capabilities, slugs, system } from "../lib/payloads";
import { actionLookup } from "../lib/plan-links";
import { hasPlan, planData } from "../lib/plan-data";
import { coveragePath, epicPath, foundationPath, planHomePath, storyPath } from "../lib/plan";

export async function getStaticPaths() {
    if (!hasPlan()) return [];
    const { plan } = await planData();
    return [
        { params: { plan: planHomePath }, props: { kind: "home", key: "" } },
        { params: { plan: foundationPath }, props: { kind: "foundation", key: "" } },
        { params: { plan: coveragePath }, props: { kind: "coverage", key: "" } },
        ...plan.epics.map((epic) => ({ params: { plan: epicPath(epic) }, props: { kind: "epic", key: epic.key } })),
        ...plan.stories.map((story) => ({ params: { plan: storyPath(story) }, props: { kind: "story", key: story.key } })),
    ];
}
const { kind, key } = Astro.props;
const data = await planData();
const lookup = actionLookup(await system(), await capabilities(), await slugs(), "../".repeat((Astro.params.plan ?? "").split("/").length - 1));
---
{kind === "home" && <PlanHome data={data} />}
{kind === "foundation" && <PlanFoundation data={data} />}
{kind === "coverage" && <PlanCoverage data={data} lookup={lookup} />}
{kind === "epic" && <PlanEpic data={data} epicKey={key} />}
{kind === "story" && <PlanStory data={data} storyKey={key} lookup={lookup} />}

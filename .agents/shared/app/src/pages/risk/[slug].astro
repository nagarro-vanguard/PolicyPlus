---
// One risk: what can go wrong, what the code shows, where it reaches.
import Page from "../../layouts/Page.astro";
import Section from "../../components/ui/Section.astro";
import Badge from "../../components/ui/Badge.astro";
import NoDataState from "../../components/ui/NoDataState.astro";
import EvidenceChip from "../../components/ui/EvidenceChip.astro";
import Meta from "../../components/analysis/Meta.astro";
import { knowledge, screenHref, slugs, system } from "../../lib/payloads";
import { screensOfRisk, splitStatement } from "../../lib/analysis";
import { words } from "../../lib/analysis-copy";
import { copy } from "../../lib/copy";
import { subjectWords, wordFor } from "../../lib/words";
import { plural, where } from "../../lib/text";

export async function getStaticPaths() {
    const know = await knowledge();
    const addresses = await slugs();
    return know.risks.map((risk) => ({ params: { slug: addresses.risk(risk.id) }, props: { id: risk.id } }));
}
const { id } = Astro.props;
const know = await knowledge();
const sys = await system();
const addresses = await slugs();
const risk = know.risks.find((each) => each.id === id);
if (risk === undefined) throw new Error("no such risk");
const screens = screensOfRisk(sys, risk);
const capHref = (cid: string) => `../capability/${addresses.capability(cid)}.html`;
const { title, lede, rest: why } = splitStatement(risk.statement);
const subjectLink = (subject: { kind: string; id: string; name: string }) => (subject.kind === "capability" && subject.id !== "" ? capHref(subject.id) : undefined);
---
<Page title={title} lead={lede} depth={1} trail={[{ text: copy.site.home, href: "../index.html" }, { text: copy.risks.title, href: "../risks.html" }, { text: title }]}>
    <Meta facts={[risk.categoryWords]}>
        <li><Badge kind={risk.severity as "high" | "medium" | "low"} /></li>
    </Meta>
    {why !== "" && <Section title={words.risks.why} id="why"><p class="a-text">{why}</p></Section>}
    <Section title={words.risks.found} id="found">
        {risk.findings.length === 0 && <NoDataState compact title="No finding recorded" message={words.risks.foundNone} />}
        {risk.findings.length > 0 && <ul class="a-list">
            {risk.findings.map((finding) => <li>
                <span class="a-text">{finding.statement}</span>
                <div class="a-sub">
                    <span>{wordFor(subjectWords, finding.subject.kind)}: {subjectLink(finding.subject) === undefined ? finding.subject.name : <a href={subjectLink(finding.subject)}>{finding.subject.name}</a>}</span>
                </div>
                {finding.evidence.length > 0 && <div class="a-evidence">{finding.evidence.map((place) => <EvidenceChip place={where(place)} />)}</div>}
            </li>)}
        </ul>}
    </Section>
    <Section title={words.risks.where} id="where">
        <h3 class="a-heading-sub">{words.risks.capabilities(risk.places.capabilities.length)}</h3>
        {risk.places.capabilities.length === 0 ? <NoDataState compact title="No capability" message={words.risks.noCapabilities} /> : <ul class="a-link-list">{risk.places.capabilities.map((place) => <li><a href={capHref(place.id)}>{place.name}</a></li>)}</ul>}
        <h3 class="a-heading-sub">{words.risks.screens(screens.length)}</h3>
        {screens.length === 0 ? <NoDataState compact title={words.risks.noScreensTitle} message={words.risks.noScreens} /> : <ul class="a-link-list">{screens.map((screen) => <li><a href={screenHref("../", screen.key)}>{screen.name}</a></li>)}</ul>}
        {risk.places.parts.length > 0 && <Fragment>
            <h3 class="a-heading-sub">{words.risks.parts(risk.places.parts.length)}</h3>
            <ul class="a-link-list">{risk.places.parts.map((part) => <li><a href="../architecture.html#lens=today&fold=containers">{part.name}</a></li>)}</ul>
        </Fragment>}
        {risk.places.files.length > 0 && <details class="fold">
            <summary>{words.risks.files(risk.places.files.length)}</summary>
            <div class="fold-body"><div class="a-evidence">{risk.places.files.map((file) => <EvidenceChip place={file} />)}</div></div>
        </details>}
    </Section>
</Page>

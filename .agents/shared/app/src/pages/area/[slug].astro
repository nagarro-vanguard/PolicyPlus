---
// A group of capabilities now has a heading on the list of capabilities and screens: this sends the reader to it.
import Redirect from "../../components/architecture/Redirect.astro";
import { areaRedirects } from "../../lib/journey-redirects";
import { slugs, system } from "../../lib/payloads";

export async function getStaticPaths() {
    const sys = await system();
    const addresses = await slugs();
    return areaRedirects(sys.areas.map((area) => addresses.area(area.id))).map((redirect) => ({ params: { slug: redirect.from.slice("area/".length) }, props: { redirect } }));
}
const { redirect } = Astro.props;
---
<Redirect redirect={redirect} />

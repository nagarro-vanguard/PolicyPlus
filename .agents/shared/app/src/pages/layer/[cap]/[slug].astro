---
// A layer of one capability, the one home of its business rules: every rule's full sentence is written here, with an anchor the
// action pages link to.
import Page from "../../../layouts/Page.astro";
import Section from "../../../components/ui/Section.astro";
import NoDataState from "../../../components/ui/NoDataState.astro";
import Meta from "../../../components/analysis/Meta.astro";
import UsedIn from "../../../components/journey/UsedIn.astro";
import { journeyModel, linksTo } from "../../../lib/journeys";
import RuleList from "../../../components/analysis/RuleList.astro";
import { capabilities, slugs } from "../../../lib/payloads";
import { actionsOfRules, alsoThrough, callersOf, filterAbove, usedByCounts } from "../../../lib/analysis";
import { words } from "../../../lib/analysis-copy";
import { copy } from "../../../lib/copy";
import { ledeOf, titleOf } from "../../../lib/derive";
import { plural } from "../../../lib/text";

export async function getStaticPaths() {
    const all = await capabilities();
    const addresses = await slugs();
    return all.flatMap((cap) =>
        cap.layers.map((layer) => ({
            params: { cap: addresses.capability(cap.capability.id), slug: addresses.layer(cap.capability.id, layer.id) },
            props: { cid: cap.capability.id, lid: layer.id },
        })),
    );
}
const { cid, lid } = Astro.props;
const addresses = await slugs();
const all = await capabilities();
const cap = all.find((each) => each.capability.id === cid);
const layer = cap?.layers.find((each) => each.id === lid);
if (cap === undefined || layer === undefined) throw new Error("no such layer");
const capSlug = addresses.capability(cid);
const used = linksTo((await journeyModel()).usingRules(layer.rules.map((rule) => rule.id)), 2);
const callers = callersOf(cap, lid).filter((caller) => caller.layer.id !== lid);
const others = alsoThrough(all, cid, layer);
const actionHref = (id: string) => `../../action/${capSlug}/${addresses.action(cid, id)}.html`;
const layerHref = (id: string) => `${addresses.layer(cid, id)}.html`;
const firstActions = layer.actions.slice(0, filterAbove);
const restActions = layer.actions.slice(filterAbove);
const row = (action: (typeof layer.actions)[number]) => ({ text: titleOf(action.purpose), href: actionHref(action.id), screen: action.screen });
---
<Page title={layer.name} lead={ledeOf(layer.purpose)} depth={2} brief={layer.context.text} trail={[{ text: copy.site.home, href: "../../index.html" }, { text: cap.capability.name, href: `../../capability/${capSlug}.html` }, { text: layer.name }]}>
    <Meta facts={[{ value: layer.actions.length, unit: layer.actions.length === 1 ? "action started here" : "actions started here" }, { value: layer.rules.length, unit: layer.rules.length === 1 ? "business rule" : "business rules" }]} />
    <UsedIn links={used} />
    {others.length > 0 && <details class="a-also fold">
        <summary>{plural(others.length, "other capability", "other capabilities")} also pass through this layer</summary>
        <div class="fold-body"><ul class="a-link-list">{others.map((other) => <li><a href={`../../capability/${addresses.capability(other.id)}.html`}>{other.name}</a></li>)}</ul></div>
    </details>}
    <Section title={words.layer.started(layer.actions.length)} id="actions">
        {layer.actions.length === 0 && <Fragment>
            <NoDataState compact title={words.layer.noStartedTitle} message={words.layer.noStarted(callers.length)} />
            {callers.length > 0 && <Fragment>
                <h3 class="a-heading-sub">{words.layer.calledBy}</h3>
                <ul class="a-list">{callers.map((caller) => <li><div class="a-row-line"><a href={layerHref(caller.layer.id)}>{caller.layer.name}</a><span class="a-aside">{plural(caller.actions, "action")} pass through here</span></div></li>)}</ul>
            </Fragment>}
        </Fragment>}
        {layer.actions.length > 0 && <Fragment>
            <ul class="a-list">
                {firstActions.map((action) => { const r = row(action); return <li><div class="a-row-line"><a href={r.href}>{r.text}</a>{r.screen !== "" && <span class="a-aside">{r.screen}</span>}</div></li>; })}
            </ul>
            {restActions.length > 0 && <details class="a-more">
                <summary>{words.layer.all(restActions.length)}</summary>
                <ul class="a-list">
                    {restActions.map((action) => { const r = row(action); return <li><div class="a-row-line"><a href={r.href}>{r.text}</a>{r.screen !== "" && <span class="a-aside">{r.screen}</span>}</div></li>; })}
                </ul>
            </details>}
        </Fragment>}
    </Section>
    <Section title={words.layer.rules(layer.rules.length)} id="rules">
        <RuleList id="layer-rules" rules={layer.rules} usedBy={usedByCounts(cap)} actions={actionsOfRules(cap, layer, (id) => addresses.action(cid, id))} />
    </Section>
    {layer.shapes.length > 0 && <details class="fold-line">
        <summary>{words.layer.shapes(layer.shapes.length)}</summary>
        <div class="fold-body">
            <ul class="a-list">
                {layer.shapes.map((shape) => <li><div class="a-row-line"><span>{shape.name}</span><span class="a-aside">{plural(shape.fields.length, "field")}</span></div>{shape.fields.length > 0 && <div class="a-sub">{shape.fields.join(", ")}</div>}</li>)}
            </ul>
        </div>
    </details>}
</Page>

---
// The data the system keeps: each kind, how it changes over time, who touches it and, when there is a modernized architecture,
// which domain owns it now. One kind's states at a time.
import Page from "../layouts/Page.astro";
import Section from "../components/ui/Section.astro";
import NoDataState from "../components/ui/NoDataState.astro";
import Kinds from "../components/architecture/Kinds.astro";
import Lives from "../components/architecture/Lives.astro";
import Picture from "../components/analysis/Picture.astro";
import AnswerList from "../components/analysis/AnswerList.astro";
import Meta from "../components/analysis/Meta.astro";
import { capabilities, knowledge, system } from "../lib/payloads";
import { knownIds } from "../lib/check";
import { briefsFor, kindsOf } from "../lib/figures";
import { copy } from "../lib/architecture-copy";
import { kindsOfData } from "../lib/architecture-owners";
import { hasTarget, targetData } from "../lib/target-data";
import { answerGroups } from "../lib/words";

const sys = await system();
const caps = await capabilities();
const know = await knowledge();
const known = knownIds(sys, caps, know);
const chosen = hasTarget() ? targetData().architecture : undefined;
const architecture = (chosen?.components ?? []).length > 0 ? chosen : undefined;
const kinds = kindsOfData(know, architecture);
const grid = briefsFor(kindsOf.data, sys, know).filter((brief) => brief.kind === "data");
const stateBrief = know.figures.find((figure) => figure.kind === "states");
const lives = know.lifecycles.toSorted((one, other) => one.entity.name.localeCompare(other.entity.name));
const owned = kinds.filter((kind) => kind.owner !== undefined).length;
---
<Page wide title={copy.data.title} lead={architecture === undefined ? copy.data.lead : copy.data.leadOwned}>
    <Meta facts={[{ value: kinds.length, unit: kinds.length === 1 ? "kind of data" : "kinds of data" }, ...(architecture === undefined ? [] : [{ value: owned, unit: owned === 1 ? "has an owner" : "have an owner" }])]} />
    {kinds.length === 0 && <NoDataState title={copy.data.noneTitle} message={copy.data.none} />}
    {kinds.length > 0 && <Section title={copy.data.kinds} id="kinds">
        <Kinds kinds={kinds} owned={architecture !== undefined} />
    </Section>}
    {lives.length > 0 && <Section title={copy.data.lives} id="lives">
        <p class="a-note">{stateBrief?.question ?? copy.data.livesNote} {stateBrief?.caption ?? ""}</p>
        <Lives lives={lives} known={known} />
    </Section>}
    {grid.length > 0 && <Section title={copy.data.grid} id="grid">
        {grid.map((brief) => <Picture brief={brief} sys={sys} knowledge={know} known={known} titled={false} />)}
    </Section>}
    <Section title={copy.data.findings} id="findings">
        <AnswerList answers={know.answers} groups={answerGroups.keeps} flat />
    </Section>
</Page>

---
// A capability: the opening and the places to look are static; everything else is drawn in the browser from the capability's
// slice (data/cap/<slug>.json), so the page's weight does not grow with the capability.
import Page from "../../layouts/Page.astro";
import Bundle from "../../components/Bundle.astro";
import Skeleton from "../../components/ui/Skeleton.astro";
import UsedIn from "../../components/journey/UsedIn.astro";
import { journeyModel, linksTo } from "../../lib/journeys";
import { bundleIndex, capabilities, knowledge, slugs, system } from "../../lib/payloads";
import { bundleCommand, bundleOfCapability } from "../../lib/bundle";
import { copy } from "../../lib/copy";
import { ledeOf } from "../../lib/derive";

export async function getStaticPaths() {
    const all = await capabilities();
    const addresses = await slugs();
    return all.map((cap) => ({ params: { slug: addresses.capability(cap.capability.id) }, props: { id: cap.capability.id } }));
}
const { id } = Astro.props;
const sys = await system();
const all = await capabilities();
const know = await knowledge();
const addresses = await slugs();
const cap = all.find((each) => each.capability.id === id);
if (cap === undefined) throw new Error("no such capability");
const held = bundleOfCapability(sys, all, know, await bundleIndex(), id);
const area = sys.areas.find((each) => each.name === cap.area);
const used = linksTo((await journeyModel()).usingCapability(id), 1);
const trail = [{ text: copy.site.home, href: "../index.html" }, ...(area ? [{ text: area.name, href: `../reference.html#${addresses.area(area.id)}` }] : []), { text: cap.capability.name }];
---
<Page title={cap.capability.name} lead={ledeOf(cap.capability.purpose)} depth={1} trail={trail}>
    <UsedIn links={used} />
    <div data-explorer="capability" data-slug={addresses.capability(id)}>
        <Skeleton lines={4} />
        <noscript><p class="note">This page is drawn in the browser from its data file. Turn on scripts to read it; the capability's details are also in the files under data/.</p></noscript>
    </div>
    <details class="fold-line">
        <summary>For a coding assistant <span class="muted">copy a brief</span></summary>
        <div class="fold-body">
            <p data-needs-js hidden><button type="button" class="btn" data-copy-brief>Copy brief for this capability</button></p>
            <Bundle files={held === undefined ? [] : held.files} command={bundleCommand(`capability "${cap.capability.name}"`)} />
        </div>
    </details>
    <script>import "../../scripts/explorer.ts";</script>
</Page>

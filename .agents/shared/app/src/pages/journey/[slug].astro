---
// One journey, today beside modernized: the title, one line of numbers, the lens (today, modernized, side by side; side by side
// once a way is proposed), the two columns row by row, why this way, and the folds that stand behind it.
import "../../styles/journey.css";
import Page from "../../layouts/Page.astro";
import Badge from "../../components/ui/Badge.astro";
import NoDataState from "../../components/ui/NoDataState.astro";
import Columns from "../../components/journey/Columns.astro";
import Folds from "../../components/journey/Folds.astro";
import { journeyModel } from "../../lib/journeys";
import { ledeOfJourney, measures, stepIds, titleOfJourney } from "../../lib/journey-join";
import { journeyCopy } from "../../lib/journey-copy";
import { hasPlan, planData } from "../../lib/plan-data";
import { storiesOf } from "../../lib/target-page";
import { hasTarget, targetData } from "../../lib/target-data";
import { titleOf } from "../../lib/derive";
import { plural } from "../../lib/text";

export async function getStaticPaths() {
    return (await journeyModel()).journeys.map((journey) => ({ params: { slug: journey.slug }, props: { slug: journey.slug } }));
}
const { slug } = Astro.props;
const model = await journeyModel();
const journey = model.journeys.find((each) => each.slug === slug);
if (journey === undefined) throw new Error("no such journey");
const way = journey.way;
const numbers = measures(journey);
const words = journeyCopy.page;
const architecture = hasTarget() ? targetData().architecture : undefined;
const plan = hasPlan() ? await planData() : undefined;
const stories = plan === undefined ? [] : storiesOf(plan.plan.stories, stepIds(journey));
const dropReason = (ids: readonly string[]) => (way?.drops ?? []).find((drop) => drop.actions.some((id) => ids.includes(id)))?.reason;
const place = journey.capability?.name ?? journey.area?.name;
const title = titleOfJourney(journey);
const lens = [["today", words.today], ["modern", words.modernized], ["both", words.both]] as const;
---
<Page title={title} lead={ledeOfJourney(journey)} depth={1} wide node={`journey:${journey.slug}`} trail={[{ text: "Overview", href: "../index.html" }, { text: "Journeys", href: "../journeys.html" }, { text: title }]}>
    <p class="facts">
        <span><b>{numbers.stepsToday}</b> {numbers.stepsToday === 1 ? "step" : "steps"} today{numbers.stepsProposed !== undefined && <Fragment> → <b>{numbers.stepsProposed}</b> proposed</Fragment>}</span>
        {way !== undefined && <span><b>{numbers.rulesKept}</b> rules kept · <b>{numbers.rulesDropped}</b> dropped</span>}
        {numbers.actionsDropped > 0 && <span>{plural(numbers.actionsDropped, "action")} dropped</span>}
        {place !== undefined && <span>{place}</span>}
        <span><Badge kind={journey.status === "decided" ? "stated" : journey.status === "proposed" ? "medium" : "neutral"} label={journeyCopy.list.status[journey.status]} /></span>
    </p>
    {way !== undefined && <div class="jr-lens" role="group" aria-label="View" data-lens-bar>
        {lens.map(([key, label]) => <button type="button" class="btn" data-lens-set={key} aria-pressed={key === "both" ? "true" : "false"}>{label}</button>)}
    </div>}
    {way === undefined && hasTarget() && <p class="jr-note">{words.noWay}</p>}
    {journey.today.current.length === 0
        ? <NoDataState compact title="No steps written down" message="The analysis found this journey but did not write its steps." />
        : <Columns journey={journey} dropReason={dropReason} />}
    {way !== undefined && <section class="jr-why-this" aria-labelledby="why-heading">
        <h2 id="why-heading">{words.why} <small>{journey.status === "decided" ? words.chosen : way.recommended !== undefined ? words.recommended : ""}{way.baseline ? ` · ${words.mirrors}` : ""}</small></h2>
        <p>{titleOf(way.idea)}</p>
        {way.recommended !== undefined && <p>{titleOf(way.recommended)}</p>}
        <p><b>{words.tradeoff}:</b> {titleOf(way.tradeoff)}</p>
    </section>}
    <div class="jr-folds"><Folds journey={journey} model={model} architecture={architecture} stories={stories} ledger={plan?.ledger} /></div>
    <script>import "../../scripts/lens.ts";</script>
</Page>

---
// A screen: one static page for every screen. The address names the screen (`screen.html#s=<key>&c=<capability>`) and the
// page draws it from that capability's slice, so a thousand screens are one file, not a thousand.
import "../styles/journey.css";
import Page from "../layouts/Page.astro";
import Skeleton from "../components/ui/Skeleton.astro";
import { bundleCommand } from "../lib/bundle";
import { copy } from "../lib/copy";
---
<Page title="Screen" lead="" trail={[{ text: copy.site.home, href: "index.html" }, { text: "Screen" }]} node="">
    <div data-explorer="screen" data-bundle-command={bundleCommand("screen")}>
        <Skeleton lines={4} />
        <noscript><p class="note">This page is drawn in the browser from its data file. Turn on scripts to read it.</p></noscript>
    </div>
    <script>import "../scripts/explorer.ts";</script>
</Page>

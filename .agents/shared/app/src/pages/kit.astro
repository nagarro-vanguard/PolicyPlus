---
import Page from "../layouts/Page.astro";
import Section from "../components/ui/Section.astro";
import Details from "../components/ui/Details.astro";
import Badge from "../components/ui/Badge.astro";
import EvidenceChip from "../components/ui/EvidenceChip.astro";
import Stat from "../components/ui/Stat.astro";
import NoDataState from "../components/ui/NoDataState.astro";
import ErrorState from "../components/ui/ErrorState.astro";
import Skeleton from "../components/ui/Skeleton.astro";
import Kbd from "../components/ui/Kbd.astro";
import Button from "../components/ui/Button.astro";
import Trail from "../components/ui/Trail.astro";
import PageOpening from "../components/ui/PageOpening.astro";
import KitPair from "../components/ui/KitPair.astro";
import Explorer from "../components/Explorer.astro";
import type { NodeView } from "../case/view";

// The kit page is the app's Storybook: every component in every variant and state, in both themes. It is built to
// kit.html and linked from no menu.
// A node as the Explorer shows it, written by hand so the kit needs no case.
const sample: NodeView = {
    key: "capability/keeping-records",
    level: "capability",
    href: "#",
    name: "Keeping records",
    summary: "People add, change and remove the records they keep.",
    noun: { one: "capability", many: "capabilities" },
    crumbs: [{ href: "#", name: "Example system" }, { href: "#", name: "Records" }],
    facts: [
        { text: "16 places: 9 pages, 7 services", scope: "places this capability's people and callers use, each counted once", value: 16 },
        { text: "42 business rules", scope: "business rules this capability decides, each counted once", value: 42 },
        { text: "1 risk", scope: "risks that name this capability", value: 1 },
    ],
    tests: { text: "3 test suites", scope: "groups of automated tests that check this capability", value: 3 },
    children: {
        heading: "Places",
        rows: [
            { href: "#", name: "Record list", line: "Lists the records and opens one.", count: { text: "4 actions", scope: "actions of this page that this capability uses", value: 4 }, kind: "page" },
            { href: "#", name: "Records service", line: "Other programs read and save records here.", count: { text: "1 action", scope: "actions of this service that this capability uses", value: 1 }, kind: "service", risk: { word: "Medium risk", badge: "medium" } },
        ],
    },
    folds: [{ kind: "openPoints", title: "Open points", rows: [{ name: "Whether a removed record can come back is not said in the code." }] }],
    up: { href: "#", name: "Records" },
    prev: null,
    next: { href: "#", name: "Reporting" },
    lateral: [{ label: "Also used by", links: [{ href: "#", name: "Reporting", count: { text: "2 actions", scope: "actions of this page that this capability uses", value: 2 } }] }],
    assistant: { file: "#", kilobytes: 12, fuller: null },
    diagrams: [{ key: "flow/keeping-records", title: "How the work passes through it", question: null, legend: ["calls"], text: ["Record list calls Records service"] }],
};
const roles = ["background", "card", "popover", "primary", "secondary", "muted", "accent", "border", "input", "ring", "destructive", "foreground", "muted-foreground"];
const scales = [
    { name: "Severity", kinds: ["high", "medium", "low"] },
    { name: "State", kinds: ["changes-state", "read-only"] },
    { name: "Provenance", kinds: ["stated", "inferred", "assumed"] },
] as const;
const sizes = [["chip", "chip and evidence, 12 pixels"], ["meta", "meta and captions, 13 pixels"], ["body", "body, 14 pixels on a 22 pixel line"], ["lead", "lede and section heading, 16 pixels"]];
const steps = ["3xs", "2xs", "xs", "md", "lg", "xxl", "4xl", "5xl"];
---
<Page wide page="kit.html" title="Design kit" lead="Every component in each variant and state, in the light and the dark theme, and in both densities.">
    <Section title="Colour roles">
        <p class="note">One accent marks the main action and the focus ring only. A met rule stays in the text colour.</p>
        <div class="kit-swatches">
            {roles.map((role) => <div class="kit-swatch"><i style={`background:var(--${role})`}></i><code>--{role}</code></div>)}
        </div>
    </Section>

    <Section title="Semantic scales">
        <p class="note">Severity, state and provenance each have three tokens (text, surface, edge) and always show an icon and a word.</p>
        <KitPair>
            {scales.map((scale) => <div>
                <h3>{scale.name}</h3>
                <div class="kit-row">{scale.kinds.map((kind) => <Badge kind={kind} />)}</div>
            </div>)}
            <h3>Neutral</h3>
            <div class="kit-row"><Badge label="Policy file" /><Badge label="8 capabilities" /></div>
        </KitPair>
    </Section>

    <Section title="Type scale">
        <div class="kit-type">
            <h2 class="kit-h1">Page heading, 28 pixels</h2>
            {sizes.map(([size, px]) => <p style={`font-size:var(--text-${size});line-height:var(--text-${size}--line-height)`}>{`Text ${size}, ${px}: the policy file holds 286 rules.`}</p>)}
            <p><code>Mono: PolicyPlus.vb:120</code></p>
            <p class="num">Tabular figures: 1,111 and 8,888 line up in a column.</p>
        </div>
    </Section>

    <Section title="Spacing and corners">
        <KitPair>
            {steps.map((step) => <div class="kit-row"><code>{step}</code><span class="kit-step" style={`inline-size:var(--space-${step})`}></span></div>)}
            <div class="kit-row"><span class="kit-corner" style="border-radius:var(--radius-control)">Control</span><span class="kit-corner" style="border-radius:var(--radius-surface)">Surface</span><span class="kit-corner" style="border-radius:var(--radius-overlay)">Overlay</span></div>
        </KitPair>
    </Section>

    <Section title="Page opening and trail">
        <KitPair>
            <Trail steps={[{ text: "Overview", href: "#" }, { text: "Policy changes", href: "#" }, { text: "Edit a policy" }]} />
            <PageOpening level={2} title="Edit a policy" summary="Change one setting and see what it does to the file." chips={["Main window", "12 actions"]} />
        </KitPair>
    </Section>

    <Section title="Explorer">
        <p class="note">One node of the hierarchy, the same anatomy at every level.</p>
        <KitPair><Explorer view={sample} root="./" /></KitPair>
    </Section>

    <Section title="Section and details">
        <KitPair>
            <Section title="A section with a rule">
                <p>A heading and a thin rule, never a card.</p>
            </Section>
            <Details summary="A fold, shut"><p>What shows on demand.</p></Details>
            <Details summary="A fold, open" open><p>Opened by the page, not by a script.</p></Details>
        </KitPair>
    </Section>

    <Section title="Buttons">
        <p class="note">One primary button per page, for the main action.</p>
        <KitPair>
            <div class="kit-row">
                <Button variant="primary">Confirm choice</Button>
                <Button>Copy a brief</Button>
                <Button variant="ghost">Cancel</Button>
            </div>
            <div class="kit-row">
                <Button variant="primary" disabled>Confirm choice</Button>
                <Button disabled>Copy a brief</Button>
                <Button variant="ghost" icon="refresh">Try again</Button>
                <Button href="#">As a link</Button>
            </div>
        </KitPair>
    </Section>

    <Section title="Evidence, numbers and keys">
        <KitPair>
            <div class="kit-row"><EvidenceChip place="PolicyPlus.vb:120" /><EvidenceChip place="Registry/PolFile.vb:48" /></div>
            <p class="note">Select a chip to copy where the claim comes from.</p>
            <div class="stats"><Stat value="286" unit="rules" label="Main window" /><Stat value="8" unit="capabilities" /><Stat value="1,204" unit="lines" /></div>
            <p>Press <Kbd>/</Kbd> to search, <Kbd>Esc</Kbd> to close.</p>
        </KitPair>
    </Section>

    <Section title="Table">
        <KitPair>
            <div class="table-wrap"><table class="table">
                <caption class="caption">Rules by capability</caption>
                <thead><tr><th scope="col">Capability</th><th scope="col">Risk</th><th scope="col" class="num">Rules</th></tr></thead>
                <tbody>
                    <tr><th scope="row">Edit a policy</th><td><Badge kind="high" /></td><td class="num">286</td></tr>
                    <tr><th scope="row">Import a file</th><td><Badge kind="medium" /></td><td class="num">41</td></tr>
                    <tr><th scope="row">Open the help</th><td><Badge kind="low" /></td><td class="num">3</td></tr>
                </tbody>
            </table></div>
        </KitPair>
    </Section>

    <Section title="The four states">
        <p class="note">Every list and page shows content, loading, no data and error, the same way.</p>
        <KitPair>
            <h3>Content</h3>
            <div class="row"><span class="main">Edit a policy</span><span class="meta">286 rules</span></div>
            <h3>Loading</h3>
            <Skeleton lines={3} />
            <h3>No data</h3>
            <NoDataState title="No risks found" message="We found nothing here. Check the other groups, or search for a rule." />
            <h3>Error</h3>
            <ErrorState title="The rules did not load" message="Something went wrong while reading them."><Button icon="refresh">Try again</Button></ErrorState>
            <h3>Compact</h3>
            <NoDataState compact title="No risks found" message="Nothing to show for this screen." />
            <ErrorState compact title="The rules did not load" message="Try again in a moment." />
        </KitPair>
    </Section>

    <Section title="Rows, folds and callouts">
        <p class="note">The pieces of the overview, a capability and a screen: a row names the thing in a full sentence, a fold is one line until opened.</p>
        <KitPair>
            <div class="list">
                <a class="row" href="#"><span class="t">Browsing policy definitions</span><span class="r">11 screens</span><span class="d">Look through the loaded policy templates and open the details of each.</span></a>
                <a class="row" href="#"><span class="t">A failed load of policy templates leaves the workspace inconsistent.</span><span class="r"><Badge kind="medium" /></span></a>
                <details class="row" open>
                    <summary><span class="t">Open the details window for a category</span><span class="r">1 rule</span></summary>
                    <ul class="rules"><li><span class="rule-text">The detail window of a category shows its parent's name and enables the parent button when the parent exists.</span><span class="ev"><EvidenceChip place="DetailCategory.vb:14" /></span></li></ul>
                </details>
            </div>
            <details class="fold-line"><summary>Controls <span class="muted">22</span></summary><div class="fold-body"><p>A folded line holds what only some readers need.</p></div></details>
            <div class="callout" role="group" aria-label="Example"><p class="t">What can go wrong on this screen</p><ul class="callout-list"><li><Badge kind="medium" /> A failed load leaves the workspace inconsistent.</li></ul></div>
            <div class="toolbar"><input type="search" aria-label="Filter rules" placeholder="Filter rules" /><select aria-label="Group the rules"><option>By action</option></select><button class="btn" type="button" aria-pressed="false">Table</button></div>
        </KitPair>
    </Section>

    <Section title="Density">
        <p class="note">Prose reads in a column of 45 rem. Tables and rows are scan density. A person chooses cozy; no page sets its own.</p>
        <KitPair>
            <div class="row"><span class="main">Compact row</span><span class="meta">12 actions</span></div>
            <div class="kit-row"><Button>Secondary</Button><Badge kind="read-only" /></div>
        </KitPair>
        <KitPair density="cozy">
            <div class="row"><span class="main">Cozy row</span><span class="meta">12 actions</span></div>
            <div class="kit-row"><Button>Secondary</Button><Badge kind="read-only" /></div>
        </KitPair>
    </Section>
</Page>

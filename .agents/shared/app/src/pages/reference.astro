---
// The reference: every capability the analysis found, under the area it belongs to, and every screen in one fold. It is where a
// claim in a journey is checked, and it replaces the pages of the areas.
import "../styles/journey.css";
import Page from "../layouts/Page.astro";
import Section from "../components/ui/Section.astro";
import Details from "../components/ui/Details.astro";
import { copy } from "../lib/copy";
import { journeyCopy } from "../lib/journey-copy";
import { sideModel } from "../lib/sidebar";
import { system, slugs } from "../lib/payloads";
import { plural } from "../lib/text";

const side = await sideModel();
const sys = await system();
const addresses = await slugs();
const words = journeyCopy.reference;
const byKey = new Map(sys.capabilities.map((cap) => [cap.id, cap] as const));
const screens = sys.screens.map((screen) => ({ key: screen.key, name: screen.name, capability: screen.capabilities.map((id) => byKey.get(id)?.name).filter((name) => name !== undefined)[0] ?? "", slug: screen.capabilities[0] === undefined ? "" : addresses.capability(screen.capabilities[0]) }));
const manyScreens = screens.length > 100;
---
<Page title={words.title} lead={words.lead} trail={[{ text: "Overview", href: "index.html" }, { text: words.title }]}>
    {side.groups.map(({ area, caps }) => <Section title={area === undefined ? copy.system.inNoArea : area.headline} id={area === undefined ? "none" : area.id.slice("area:".length)}>
        {area?.summary !== undefined && <p class="jr-sub">{area.summary}</p>}
        <div class="list">
            {caps.map((item) => <a class="row" href={item.href} data-astro-prefetch="hover">
                <span class="t">{item.headline}</span>
                <span class="r">{(item.counts?.screens ?? 0) > 0 ? plural(item.counts?.screens ?? 0, "screen") : plural(item.counts?.rules ?? 0, "rule")}</span>
                {item.summary !== undefined && <span class="d">{item.summary}</span>}
            </a>)}
        </div>
    </Section>)}
    {screens.length > 0 && !manyScreens && <Details summary={`All screens: ${screens.length}`}>
        <ul class="jr-list">{screens.map((screen) => <li><a href={`screen.html#s=${encodeURIComponent(screen.key)}&c=${screen.slug}`}>{screen.name}</a> <span class="jr-sub">{screen.capability}</span></li>)}</ul>
    </Details>}
</Page>

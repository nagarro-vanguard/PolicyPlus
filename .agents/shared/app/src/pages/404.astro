---
import Page from "../layouts/Page.astro";
import { NotFound } from "../components/NotFound";
import { caseData } from "../case/data";
import { viewOf } from "../case/view";
import { copy } from "../lib/copy";
// An address that leads to no page: the reader lands on the top of the hierarchy with a search box, never on a dead end.
// An old address of an action or a rule (`action/<slug>.html`) is sent on to the page that now holds it.
const view = viewOf("overview", await caseData());
---
<Page title={copy.notFound.title} lead={copy.notFound.lead} page="404.html">
    <NotFound view={view} />
</Page>

---
import Page from "../layouts/Page.astro";
import { Explorer } from "../components/Explorer";
import { GoalPage } from "../components/goals/Goals";
import { Crumbs } from "../components/shell/Crumbs";
import { caseData, caseNodes } from "../case/data";
import { heading } from "../case/format";
import { goalsPage } from "../case/goals-page";
import { hasPage, keyOfPath, pageOf, pathOf, rootOf } from "../case/routes";
import { viewOf } from "../case/view";
// One page per node of a page level, at the address its key makes (`capability/keeping-records.html`). Actions and
// rules open on these pages, at `#<key>`, in the drawer beside the Explorer, which the page's script draws from the
// pieces in `data/parts.html`, read the first time a drawer opens.
export const getStaticPaths = async () =>
    (await caseNodes()).filter((node) => hasPage(node.level)).map((node) => ({ params: { key: pathOf(node.key) } }));
const key = keyOfPath((Astro.params as { key: string }).key);
const page = pageOf(key);
const root = rootOf(page);
const view = viewOf(key, await caseData());
// A goal has no children or folds to explore: its page says where each stage of the work considered it.
const goal = key.startsWith("goal/") ? (await goalsPage())?.goals.find((each) => each.key === key) : undefined;
const context = view.context === null ? null : { file: `${root}${view.context.file}`, kilobytes: view.context.kilobytes };
---
<Page title={view.name} lead={goal === undefined ? view.summary : ""} page={page} writtenBy="agent" label={heading(view.noun.one)} facts={{ facts: view.facts, tests: view.tests }} context={context} drawer={goal === undefined}>
    <Crumbs slot="trail" crumbs={view.crumbs} current={view.name} root={root} />
    {goal === undefined ? <Explorer view={view} root={root} /> : <GoalPage goal={goal} root={root} />}
</Page>

---
import Page from "../layouts/Page.astro";
import Explorer from "../components/Explorer.astro";
import { caseData, caseNodes } from "../case/data";
import { hasPage, keyOfPath, pageOf, pathOf, rootOf } from "../case/routes";
import { viewOf } from "../case/view";
import { copy } from "../lib/copy";
// One page per node of a page level, at the address its key makes (`capability/keeping-records.html`). Actions and
// rules open on these pages, at `#<key>`, in the detail below the Explorer.
export const getStaticPaths = async () =>
    (await caseNodes()).filter((node) => hasPage(node.level)).map((node) => ({ params: { key: pathOf(node.key) } }));
const key = keyOfPath((Astro.params as { key: string }).key);
const page = pageOf(key);
const root = rootOf(page);
const view = viewOf(key, await caseData());
---
<Page title={view.name} lead={view.summary} page={page} writtenBy="agent">
    {view.crumbs.length > 0 && <nav class="trail" aria-label={copy.site.trail} slot="trail">
        <ol>{view.crumbs.map((crumb) => <li><a href={`${root}${crumb.href}`} data-written-by="agent">{crumb.name}</a><span aria-hidden="true">/</span></li>)}<li><span aria-current="page" data-written-by="agent">{view.name}</span></li></ol>
    </nav>}
    <Explorer view={view} root={root} />
    <section id="detail" class="detail" hidden aria-live="polite"></section>
</Page>

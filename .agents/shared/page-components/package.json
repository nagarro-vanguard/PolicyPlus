{
    "name": "@nagarro/page-components",
    "version": "0.1.0",
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/bun": "1.4.2",
        "eslint": "10.12.0",
        "eslint-plugin-import-x": "4.17.1",
        "eslint-plugin-jsdoc": "65.1.0",
        "jiti": "2.7.0",
        "knip": "6.39.0",
        "prettier": "3.9.9",
        "typescript": "5.9.3",
        "typescript-eslint": "8.71.0",
        "vite": "8.3.2",
        "vitest": "5.0.3"
    },
    "engines": {
        "bun": ">=1.4.0"
    },
    "private": true,
    "scripts": {
        "catalogue": "bun build-catalogue.tsx",
        "typecheck": "tsc --noEmit",
        "test": "bun --bun vitest run",
        "lint": "eslint .",
        "format": "prettier --write '**/*.{ts,tsx}'",
        "format:check": "prettier --check '**/*.{ts,tsx}'",
        "knip": "knip && knip --production",
        "check": "bun run format:check && bun run lint && bun run knip && bun run typecheck && bun run test"
    },
    "type": "module"
}

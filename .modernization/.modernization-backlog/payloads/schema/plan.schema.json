          },
          "what": {
            "type": "string",
            "minLength": 1,
            "description": "What the story delivers: the capability wanted, or the goal of a technical story."
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "description": "The outcome it serves: the reason for the capability, or the problem a technical story solves."
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The legacy entry points this story ports; empty for a technical story."

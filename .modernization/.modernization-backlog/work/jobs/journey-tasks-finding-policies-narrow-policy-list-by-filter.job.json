  "usedComponents": [
    {
      "name": "Visibility Judge",
      "domain": "Policy Discovery",
      "responsibility": "Decides whether a policy is listed, from the chosen area and, when the filter is on, from every active part of the limit: type, state, comment and products.",
      "module": "visibility-judge",
      "uses": [
        "Policy state presenter",
        "Policy Comment Catalog",
        "Support evaluator"
      ],
      "enforces": [
        {
          "id": "businessrule-09965726926686583005",
          "says": "A policy is visible only if it applies to a chosen area (user, computer or both). With \"Only Filtered Policies\" on, it must also pass the filter for a chosen area it applies to; passing for either one is enough."
        },
        {
          "id": "businessrule-12540995342195943001",
          "says": "A filter on state keeps only policies whose state in the checked area is Configured (Enabled or Disabled), Not Configured, Disabled or Enabled, as chosen."
        },
        {
          "id": "businessrule-67323359061601595450",
          "says": "A filter on managed policies hides preferences when managed policies are wanted, and hides managed policies when preferences are wanted."
        },
        {
          "id": "businessrule-70331897906623822249",
          "says": "A policy passes the filter only when it passes every active part of it."
        },
        {
          "id": "businessrule-79960316131030112593",
          "says": "A filter on comments keeps only policies that have a non-empty comment in the checked area, or only those that have none, as chosen."
        },
        {
          "id": "businessrule-97862941341357225531",
          "says": "A filter on products keeps only policies supported by the chosen products, honouring the options to match any product and to include policies with blank support."
        }
      ]
    },
    {
      "name": "Product browser",
      "domain": "Policy Definitions",
      "responsibility": "Lists products with child counts and shows versions and details.",
      "module": "product-browser",
      "uses": [],
      "enforces": [
        {
          "id": "businessrule-12357125815438552418",
          "says": "The major versions list shows the children of the selected top-level product ordered by version, with the heading naming that product; with no product selected it is empty and prompts the person to select one."
        },
        {
          "id": "businessrule-52738497804454297244",
          "says": "Opening product details by double-click or Enter does nothing when no product is selected in that list."
        },
        {
          "id": "businessrule-69465149169735487446",
          "says": "The minor versions list shows the children of the selected major version ordered by version, with the heading naming it; with no major version selected it is empty and prompts the person to select one."
        },
        {
          "id": "businessrule-77846110822300189675",
          "says": "Double-clicking a child revision in the product details window shows that child in the same window; with nothing selected, nothing happens."
        },
        {
          "id": "businessrule-93683837313593251984",
          "says": "The top-level products list shows every loaded product ordered by name, each with its number of children."
        },
        {
          "id": "businessrule-27325316460229917481",
          "says": "The product details window lists every child revision of a product with its version and name; a product with no children shows an empty list."
        },
        {
          "id": "businessrule-39702010276849006236",
          "says": "A product with a parent shows the parent name and enables the parent button; a product with no parent shows a blank parent and the button is disabled."
        },
        {
          "id": "businessrule-86698236183201307158",
          "says": "The product details window shows a version number for major and minor revisions only; for a top-level product the version is blank."
        },
        {
          "id": "businessrule-95233256539481592648",
          "says": "The product details window labels a product \"Major revision\", \"Minor revision\" or \"Top-level product\" from its type."
        }
      ]
    },
    {
      "name": "Visible Category Follow",
      "domain": "Policy Source",
      "responsibility": "After sources open or a view setting changes, moves to the nearest visible category and drops a selection that is no longer shown.",
      "module": "visible-category-follow",
      "uses": [],
      "enforces": [
        {
          "id": "businessrule-10464012301936997836",
          "says": "After the person chooses policy sources, they are opened with the opening result shown, and the view moves to the nearest visible category."
        },
        {
          "id": "businessrule-84588009124214109370",
          "says": "When a view setting changes, the program moves up to the nearest visible category, drops the selected policy if the move happened or the policy is now hidden, then rebuilds the tree and list. A policy kept after the move appears in the information pane only: rebuilding the list reselects the category in the tree, which clears the selection, so its row is not highlighted."
        }
      ]
    }
  ],

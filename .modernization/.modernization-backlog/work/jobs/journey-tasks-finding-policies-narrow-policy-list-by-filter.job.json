  "journey": {
    "name": "Live filter",
    "idea": "Choices narrow the policy list the moment they are made, with no confirm step, and a person can revert or switch the limit off at any time.",
    "outcome": "Limit the policy list to policies of a chosen type, state, comment status and supported products, and switch that limit on or off."
  },
  "stepDetails": [
    {
      "id": "tasks-finding-policies.narrow-policy-list-by-filter:live-filter#1",
      "intent": "See the limit currently in force.",
      "system": "Shows type, state, comment and products as the current limit holds, with Any and no products when it has no such condition and the support option off with both matching options on when it has no support condition.",
      "change": "defaulted",
      "reason": "The person starts from what is in force, not a blank form.",
      "today": [
        {
          "id": "block-69596352550727046885",
          "what": "Asks for filter settings and turns the filtered view on."
        }
      ],
      "keeps": [
        {
          "id": "businessrule-01575097247784730570",
          "says": "When the current filter has a supported-on condition, the dialog opens with Supported on ticked, exactly the filter's products ticked and the two matching options set as the filter holds; product branches whose tick differs from their parent are opened."
        },
        {
          "id": "businessrule-76306981111385169671",
          "says": "When the current filter has no supported-on condition, the dialog opens with Supported on unticked, both \"Match a policy if at least one selected product is supported\" and \"Match policies with missing or blank support definitions\" ticked, and no product ticked."
        },
        {
          "id": "businessrule-26561900736287578271",
          "says": "When the filter dialog opens, the Current state choice shows Any if the current filter has no state condition, otherwise Not Configured, Configured, Enabled or Disabled as the filter holds."
        },
        {
          "id": "businessrule-32591775124677875588",
          "says": "When the filter dialog opens, the Policy type choice shows Any if the current filter has no policy-type condition, Policy if it keeps only managed policies, and Preference if it keeps only the others."
        },
        {
          "id": "businessrule-59209755491778300947",
          "says": "When the filter dialog opens, the Commented choice shows Any if the current filter has no comment condition, Yes if it keeps only commented policies and No if it keeps only uncommented ones."
        }
      ]
    },
    {
      "id": "tasks-finding-policies.narrow-policy-list-by-filter:live-filter#2",
      "intent": "Choose a policy type, state and comment status.",
      "system": "Keeps only managed for Policy, only unmanaged for Preference, the chosen state, and commented or uncommented as chosen; Any sets no condition. The list narrows now.",
      "change": "merged",
      "reason": "No confirming step; each choice applies as made.",
      "today": [
        {
          "id": "block-88991021756869656536",
          "what": "Builds the filter from the chosen options and closes the dialog accepted"
        }
      ],
      "keeps": [
        {
          "id": "businessrule-03237181236179074787",
          "says": "When OK is pressed, the new filter keeps only managed policies for Policy, only unmanaged ones for Preference, and no policy-type condition for Any."
        },
        {
          "id": "businessrule-81055540068763556055",
          "says": "When OK is pressed, the new filter requires the chosen state: Not Configured, Configured, Enabled or Disabled; Any sets no state condition."
        },
        {
          "id": "businessrule-70906412717211463954",
          "says": "When OK is pressed, the new filter keeps only commented policies for Yes, only uncommented ones for No, and no comment condition for Any."
        }
      ]
    },
    {
      "id": "tasks-finding-policies.narrow-policy-list-by-filter:live-filter#3",
      "intent": "Limit by supported products.",
      "system": "Opens product choice only while a support limit is wanted; choosing a product by hand also chooses the products under it, but loading a limit does not spread; records chosen products and both matching options, and accepts a support limit with no product.",
      "change": "merged",
      "reason": "Product choice appears only when asked for.",
      "today": [
        {
          "id": "block-26736796202907003543",
          "what": "Enables the product requirements box only while Supported on is ticked"
        },
        {
          "id": "block-44706239895339562170",
          "what": "Applies the new tick to all child products"
        },
        {
          "id": "block-88991021756869656536",
          "what": "Builds the filter from the chosen options and closes the dialog accepted"
        },
        {
          "id": "block-55576298759886274598",
          "what": "Drops the double-click message so the tree check state stays in step"
        }
      ],
      "keeps": [
        {
          "id": "businessrule-88807660791719489759",
          "says": "The product requirement box (the product tree and the two matching options) can be used only while Supported on is ticked; it starts unusable."
        },
        {
          "id": "businessrule-61457439461915744538",
          "says": "Ticking or unticking a product by hand ticks or unticks every product beneath it to match; changes made by the dialog itself do not spread."
        },
        {
          "id": "businessrule-90628240213834851721",
          "says": "When OK is pressed with Supported on ticked, the filter records every ticked product and both matching options; with it unticked, any ticks and options are discarded and no support condition applies. A filter with Supported on ticked and no product ticked is accepted."
        }
      ]
    },
    {
      "id": "tasks-finding-policies.narrow-policy-list-by-filter:live-filter#4",
      "intent": "Be taken to the right place when the limit changes.",
      "system": "Turns the limit on and moves to the nearest category still shown.",
      "change": "inferred",
      "reason": "Changing a limit already means wanting it on.",
      "today": [
        {
          "id": "block-69596352550727046885",
          "what": "Asks for filter settings and turns the filtered view on."
        }
      ],
      "keeps": [
        {
          "id": "businessrule-85052319902195299547",
          "says": "Changing the filter options turns on \"Only Filtered Policies\" and moves to the nearest visible category."
        }
      ]
    },
    {
      "id": "tasks-finding-policies.narrow-policy-list-by-filter:live-filter#5",
      "intent": "Switch the limit on or off without losing it.",
      "system": "Applies or lifts the limit and moves to the nearest category still shown.",
      "change": "kept",
      "reason": "Switching is quick and non-destructive.",
      "today": [
        {
          "id": "block-40488572982447813355",
          "what": "Switches whether the filter is applied to the lists."
        }
      ],
      "keeps": [
        {
          "id": "businessrule-36944318108231327872",
          "says": "The \"Only Filtered Policies\" menu switches the filter on or off and moves to the nearest visible category."
        }
      ]
    },
    {
      "id": "tasks-finding-policies.narrow-policy-list-by-filter:live-filter#6",
      "intent": "Start again from nothing.",
      "system": "Returns type, state and comment to Any, support off, both matching options on and no product.",
      "change": "kept",
      "reason": "A clean slate in one action.",
      "today": [
        {
          "id": "block-27559849759497597302",
          "what": "Sets the dialog back to a filter that matches everything"
        }
      ],
      "keeps": [
        {
          "id": "businessrule-81206266674090971597",
          "says": "Reset returns every choice to its default: Any for type, state and comment, Supported on unticked, both matching options ticked and no product ticked."
        }
      ]
    },
    {
      "id": "tasks-finding-policies.narrow-policy-list-by-filter:live-filter#7",
      "intent": "Undo this round of changes.",
      "system": "Puts back the limit held when the person began and leaves it unchanged.",
      "change": "kept",
      "reason": "Backing out stays possible although choices applied live.",
      "today": [
        {
          "id": "block-03044886867739368079",
          "what": "Closes the dialog as cancelled when Escape is pressed"
        }
      ],
      "keeps": [
        {
          "id": "businessrule-57716378734614233724",
          "says": "Pressing Escape closes the filter dialog as cancelled and the current filter is unchanged."
        }
      ]
    }
  ],

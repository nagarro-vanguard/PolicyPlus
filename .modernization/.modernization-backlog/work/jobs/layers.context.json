  "purpose": "Policy Plus is a Windows desktop editor for Group Policy settings, used by administrators and power users. It reads Microsoft's policy definition files and edits policy files directly, so it works on any Windows edition, including Home, which lacks the built-in editor.",
  "capabilities": [
    {
      "name": "Building and versioning Policy Plus",
      "purpose": "Stamp the program with its current Git version when it is built.",
      "actions": 1
    },
    {
      "name": "Getting Microsoft policy definitions",
      "purpose": "Download Microsoft's current policy template package and unpack it into a folder the program can read.",
      "actions": 6
    },
    {
      "name": "Using the product",
      "purpose": "Product's own settings, such as the language of the policy text.",
      "actions": 6
    },
    {
      "name": "Choosing and saving policy sources",
      "purpose": "Pick where the user and computer policies are kept (POL file, registry, a user's registry hive, a user's Group Policy object, or the live system) and save changes back to them.",
      "actions": 15
    },
    {
      "name": "Changing policy settings",
      "purpose": "Set a policy to Enabled, Disabled or Not configured with its options and comment, and move settings in or out as SPOL text.",
      "actions": 24
    },
    {
      "name": "Finding policies",
      "purpose": "Narrow the policy list by filter and find policies by ID, text or registry key and value, then pick a result.",
      "actions": 29
    },
    {
      "name": "Editing policy files directly",
      "purpose": "Change the raw keys and values of a policy file, and bring registry files in or out of it.",
      "actions": 35
    },
    {
      "name": "Browsing policy definitions",
      "purpose": "Look through the loaded policy templates: categories, products, support rules, template files and policies, and open the details of each.",
      "actions": 47
    }
  ],
  "outsideSystems": [
    "Computer file system folders",
    "Windows registry policy keys and loaded user hives",
    "Administrative template files (ADMX and ADML)",
    "Windows registry settings key of Policy Plus",
    "Generated version source file",
    "Policy comment files (CMTX)",
    "Active Directory domain",
    "Microsoft download site"
  ],
  "stack": [
    "language and runtime: TypeScript on Bun, in a Turborepo workspace of packages and apps",
    "screens: TanStack Start, server rendered, with React 19, TanStack Router, Query and Form, Tailwind 4, shadcn on Base UI with Storybook for the components, lucide icons, Paraglide for the messages, Playwright for e2e tests",
    "services: Effect 4 HttpApi with Effect Schema, with an OpenAPI document generated from the same contract, served on Bun",
    "data: PostgreSQL through Drizzle on Effect SQL, with Drizzle Kit migrations",
    "checks: Vitest for tests, Playwright with axe for black-box and accessibility tests, ESLint, Prettier, knip, markdownlint, commitlint with conventional commits, lefthook"
  ],

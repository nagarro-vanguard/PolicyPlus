  "journey": {
    "name": "Prefix worked out for you",
    "idea": "The person gives the exported settings and where they go; the system validates, works out the key prefix and reports what it found before applying.",
    "outcome": "Bring the contents of an exported set of machine settings into a policy source."
  },
  "stepDetails": [
    {
      "id": "tasks-editing-policy-files-directly.import-registry-file-into-policy-source:prefix-worked-out-for-you#1",
      "intent": "Choose the exported machine settings and the policy source (user or computer) they should be brought into.",
      "system": "The system accepts only exported-settings files and remembers the chosen source.",
      "change": "merged",
      "reason": "File and destination are given together instead of in separate steps.",
      "today": [
        {
          "id": "block-89194191501498123777",
          "what": "Lets the person pick a REG file and guesses the key prefix from it."
        },
        {
          "id": "block-42014485464934566054",
          "what": "Opens the registry file import dialog and refreshes the list if values were imported."
        }
      ],
      "keeps": [
        {
          "id": "businessrule-00824990257185597112",
          "says": "Only files of type *.reg are offered by the file chooser when browsing for the REG file."
        },
        {
          "id": "businessrule-60060400053285241820",
          "says": "Importing a registry file (REG) applies it to the policy source of the area the person chooses and refreshes the view."
        }
      ]
    },
    {
      "id": "tasks-editing-policy-files-directly.import-registry-file-into-policy-source:prefix-worked-out-for-you#2",
      "intent": "Be told what the file contains and how its keys will be named in the source.",
      "system": "The system checks the file is a genuine export, ignores blank and comment lines, reads keys, removals, deletions and default values, works out the key prefix from the first key, and warns when the file holds default values or the prefix could not be worked out.",
      "change": "inferred",
      "reason": "The system derives the prefix and the warnings instead of making the person type or discover them.",
      "today": [
        {
          "id": "block-89194191501498123777",
          "what": "Lets the person pick a REG file and guesses the key prefix from it."
        }
      ],
      "keeps": [
        {
          "id": "businessrule-52142616153788952070",
          "says": "A REG file is refused when its first line is not 'Windows Registry Editor Version 5.00', with the message 'Incorrect REG signature'."
        },
        {
          "id": "businessrule-55584576559812010511",
          "says": "Blank lines and lines starting with a semicolon in a REG file are ignored."
        },
        {
          "id": "businessrule-57877192145861745927",
          "says": "A REG key header starting with a minus sign marks the whole key for removal. Otherwise it opens a key whose values follow."
        },
        {
          "id": "businessrule-23306400970907693227",
          "says": "A REG file value line starting with an at sign is the key's default value, with an empty name."
        },
        {
          "id": "businessrule-59618595788928559733",
          "says": "In a REG file, a value written as a bare minus sign is a value to delete. A quoted value is text, 'dword:' is a 32-bit number in hexadecimal, and 'hex' is bytes, typed by the number in brackets or binary if none. Data in none of these forms is kept as a value with no data and no type, with no error, and applying it writes an empty value or fails."
        },
        {
          "id": "businessrule-18921117498420510792",
          "says": "A REG file is reported as holding default values when any value has an empty name."
        },
        {
          "id": "businessrule-75481654180830858390",
          "says": "The prefix of a REG file is guessed from its first key only. For a key starting with 'HKEY_USERS\\' it is that hive plus the user identifier. For any other key, including HKEY_CURRENT_USER, it is the hive name alone. A first key with no further backslash gives an empty prefix. A file with no keys gets 'HKEY_LOCAL_MACHINE\\'."
        },
        {
          "id": "businessrule-89009644626675244455",
          "says": "When a REG file is chosen and the prefix is empty, the prefix is guessed from the file; if the file holds default values, the person is warned \"This REG file contains data for default values, which cannot be applied to all policy sources.\""
        },
        {
          "id": "businessrule-17451417049747776074",
          "says": "When the guess fails, the person is only warned \"An error occurred while trying to guess the prefix.\" and the prefix stays empty."
        },
        {
          "id": "businessrule-18627979551357993299",
          "says": "A REG key name is shortened by the prefix only when it starts with it, regardless of case. A prefix always ends in a backslash."
        }
      ]
    },
    {
      "id": "tasks-editing-policy-files-directly.import-registry-file-into-policy-source:prefix-worked-out-for-you#3",
      "intent": "Give a prefix only if the system could not decide one.",
      "system": "The system refuses to continue without a file or a prefix and says which is missing.",
      "change": "deferred",
      "reason": "The prefix is asked only in the rare case it is unknown.",
      "today": [
        {
          "id": "block-13677197335497518185",
          "what": "Loads the chosen REG file with its prefix and applies it to the policy source."
        }
      ],
      "keeps": [
        {
          "id": "businessrule-97032716123610483497",
          "says": "Import is refused with \"Please specify a REG file to import.\" when no file is named, and with \"Please specify the prefix used to fully qualify paths in the REG file.\" when no prefix is given."
        }
      ]
    },
    {
      "id": "tasks-editing-policy-files-directly.import-registry-file-into-policy-source:prefix-worked-out-for-you#4",
      "intent": "Bring the settings into the source.",
      "system": "The system removes marked keys, deletes marked values, saves the others with the prefix removed from names, tells the person only that the import failed if it does, then refreshes what the person sees.",
      "change": "merged",
      "reason": "Applying and refreshing are one outcome rather than separate actions.",
      "today": [
        {
          "id": "block-13677197335497518185",
          "what": "Loads the chosen REG file with its prefix and applies it to the policy source."
        },
        {
          "id": "block-61484076288336240425",
          "what": "Imports a registry export (REG) file into a policy source."
        }
      ],
      "keeps": [
        {
          "id": "businessrule-45318436042524755037",
          "says": "When a REG file is applied to a source, a key marked for removal is cleared, a value marked for deletion is deleted and any other value is saved. A key name starting with the prefix is applied without it. A key not starting with the prefix is applied with its full original name, so the registry source would create a key of that name. The source branch limit is not checked."
        },
        {
          "id": "businessrule-61966293182360194116",
          "says": "Import loads the REG file with the prefix and applies it straight to the chosen policy source; on any failure the person is told only \"Failed to import the REG file.\""
        },
        {
          "id": "businessrule-60060400053285241820",
          "says": "Importing a registry file (REG) applies it to the policy source of the area the person chooses and refreshes the view."
        }
      ]
    },
    {
      "id": "tasks-editing-policy-files-directly.import-registry-file-into-policy-source:prefix-worked-out-for-you#5",
      "intent": "Leave without importing.",
      "system": "The system changes nothing.",
      "change": "kept",
      "reason": "Backing out stays available at every point.",
      "today": [
        {
          "id": "block-37220153383335897650",
          "what": "Closes the window as cancelled when Escape is pressed."
        }
      ],
      "keeps": [
        {
          "id": "businessrule-59516130836014950967",
          "says": "Pressing Escape closes Import REG as cancelled."
        }
      ]
    }
  ],

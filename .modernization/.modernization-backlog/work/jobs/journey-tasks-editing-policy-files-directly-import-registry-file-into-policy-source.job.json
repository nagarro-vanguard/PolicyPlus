  "usedComponents": [
    {
      "name": "Computer File Access",
      "domain": "Policy Source",
      "responsibility": "Reads and writes policy files and their folders on the machine, creating missing policy files empty and opening them for reading and writing.",
      "module": "computer-file-access",
      "uses": [],
      "adapts": "external-90077838450756006603",
      "enforces": [
        {
          "id": "businessrule-79173574861552738237",
          "says": "When the Registry.pol of a POL file source, the local Group Policy or a per-user Group Policy does not exist, it is created empty with its folder and treated as writable; a mistyped SID therefore creates a new folder and empty file under the per-user policy folder. If creation fails, an empty read-only source is used and no error is shown."
        },
        {
          "id": "businessrule-49395771262191850050",
          "says": "A source read through the file branch covers a POL file, the local Group Policy and a per-user Group Policy, each with a Registry.pol path. An existing file is loaded; it is writable only when it can be opened for reading and writing, otherwise it can be viewed but not committed."
        }
      ]
    },
    {
      "name": "Source Choice Builder",
      "domain": "Policy Source",
      "responsibility": "Creates the user and computer sources from the chosen kind and detail, naming which side failed and why.",
      "module": "source-choice-builder",
      "uses": [
        "Source Opener"
      ],
      "enforces": [
        {
          "id": "businessrule-36363277387876573326",
          "says": "When OK is pressed, the user source is created from the selected choice: Local GPO, Registry, POL file, per-user GPO (SID typed), user hive (file path typed), or Scratch space otherwise. If it cannot be created, the person is told \"The user policy loader could not be created.\" followed by the reason, and the dialog stays open; the dialog closes as accepted only when both sources were created."
        },
        {
          "id": "businessrule-75533700456390778594",
          "says": "When OK is pressed, the computer source is created from the selected choice: Local GPO, Registry (path typed), POL file (name typed), or Scratch space when none of the others is selected. If it cannot be created, the person is told \"The computer policy loader could not be created.\" followed by the reason, and the dialog stays open."
        }
      ]
    },
    {
      "name": "User Identification Entry",
      "domain": "Policy Source",
      "responsibility": "Ends the naming of a user without a choice when the person leaves.",
      "module": "user-identification-entry",
      "uses": [
        "Directory Account Resolver"
      ],
      "enforces": [
        {
          "id": "businessrule-26724904229141688759",
          "says": "Pressing Escape closes the user dialog as cancelled."
        }
      ]
    },
    {
      "name": "Policy Change Applier",
      "domain": "Policy Source",
      "responsibility": "Applies the changes of one policy file onto another source, including marker-style entries and the forgetting of dropped values.",
      "module": "policy-change-applier",
      "uses": [
        "Policy File Entries",
        "Live Registry Values"
      ],
      "enforces": [
        {
          "id": "businessrule-05545231242611046306",
          "says": "When a policy file's changes are applied to another source, an entry is saved only if it has a non-empty value name that does not start with '**'. Other marker-style entries and entries with an empty value name are skipped without notice. A saved value keeps its original letter case and type."
        },
        {
          "id": "businessrule-28402048173344159866",
          "says": "When a policy file's changes are applied to another source, an entry starting '**deletekeys' clears each key named in its semicolon-separated list under the entry's key, using lower-case names. Clearing removes only that key's own values, not its subkeys."
        },
        {
          "id": "businessrule-41013546429447756519",
          "says": "When a newer policy file is applied over an older one, values the old file held and the new one dropped are forgotten in the target, but only if they sit under the three policy branches of the registry."
        },
        {
          "id": "businessrule-67697422395860869033",
          "says": "When a policy file's changes are applied to another source, an entry named '**deletevalues' deletes each value in its semicolon-separated list, using lower-case names."
        },
        {
          "id": "businessrule-84817748081019740495",
          "says": "When a policy file's changes are applied to another source, an entry named '**del.' plus a value name deletes that value, using the lower-case key and value names."
        },
        {
          "id": "businessrule-91552597921533368557",
          "says": "When a policy file's changes are applied to another source, an entry starting '**delvals' clears the whole key, using the lower-case key name. Entries are applied in sorted order, so clear-all entries come before values. Clearing a live registry key removes only that key's own values."
        }
      ]
    },
    {
      "name": "Policy File Entries",
      "domain": "Policy Source",
      "responsibility": "Holds the entries of one policy file in memory and answers presence, reading, setting, forgetting, deletion marking and key clearing.",
      "module": "policy-file-entries",
      "uses": [
        "Policy File Codec"
      ],
      "enforces": [
        {
          "id": "businessrule-17641776170698884064",
          "says": "A value in a policy file counts as marked for deletion when a deletion marker names it, when the key has a clear-all marker, or when a delete-values list for the key names it, regardless of case. Entries are examined in sorted order, and a value whose name sorts after the marker is stored as present and cancels the deletion, whenever it was written and whichever marker kind came before."
        },
        {
          "id": "businessrule-18230757898637060853",
          "says": "Listing the values of a key in a policy file leaves out the marker entries unless the caller asks for them."
        },
        {
          "id": "businessrule-29530054883116088403",
          "says": "Reading a value from a policy file gives nothing when the value is absent or marked for deletion."
        },
        {
          "id": "businessrule-46824143239519073718",
          "says": "A value in a policy file counts as present only if it is stored and not marked for deletion."
        },
        {
          "id": "businessrule-56421390704826486738",
          "says": "A value counts as present when: for a deletion marker, it is marked for deletion; for a number, it exists as a whole number and equals the expected number; for text, it exists as text and equals the expected text. A value of the wrong kind is not present."
        },
        {
          "id": "businessrule-72149976207795359606",
          "says": "When a value is marked for deletion in a policy file, any value or marker already held under that name is dropped first. A deletion marker holding the number 32, as Microsoft does, is added unless the value is already marked or its key is cleared."
        },
        {
          "id": "businessrule-86190343622453999219",
          "says": "When a value is set in a policy file, it replaces any value already held under that name. A deletion marker for the name is not removed."
        },
        {
          "id": "businessrule-43613259767674592997",
          "says": "When a value is forgotten in a policy file, both the value and its deletion marker are removed, so the policy reverts to not saying anything about it."
        },
        {
          "id": "businessrule-09208070518455812303",
          "says": "When a policy file is clearing a key, all values and markers under the key are dropped and a single clear-all marker is stored."
        }
      ]
    }

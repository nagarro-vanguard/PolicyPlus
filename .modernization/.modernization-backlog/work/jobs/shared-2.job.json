  "componentDetails": [
    {
      "name": "Policy Change Applier",
      "domain": "Policy Source",
      "responsibility": "Applies the changes of one policy file onto another source, including marker-style entries and the forgetting of dropped values.",
      "module": "policy-change-applier",
      "uses": [
        "Policy File Entries",
        "Live Registry Values"
      ],
      "enforces": [
        {
          "id": "businessrule-05545231242611046306",
          "says": "When a policy file's changes are applied to another source, an entry is saved only if it has a non-empty value name that does not start with '**'. Other marker-style entries and entries with an empty value name are skipped without notice. A saved value keeps its original letter case and type."
        },
        {
          "id": "businessrule-28402048173344159866",
          "says": "When a policy file's changes are applied to another source, an entry starting '**deletekeys' clears each key named in its semicolon-separated list under the entry's key, using lower-case names. Clearing removes only that key's own values, not its subkeys."
        },
        {
          "id": "businessrule-41013546429447756519",
          "says": "When a newer policy file is applied over an older one, values the old file held and the new one dropped are forgotten in the target, but only if they sit under the three policy branches of the registry."
        },
        {
          "id": "businessrule-67697422395860869033",
          "says": "When a policy file's changes are applied to another source, an entry named '**deletevalues' deletes each value in its semicolon-separated list, using lower-case names."
        },
        {
          "id": "businessrule-84817748081019740495",
          "says": "When a policy file's changes are applied to another source, an entry named '**del.' plus a value name deletes that value, using the lower-case key and value names."
        },
        {
          "id": "businessrule-91552597921533368557",
          "says": "When a policy file's changes are applied to another source, an entry starting '**delvals' clears the whole key, using the lower-case key name. Entries are applied in sorted order, so clear-all entries come before values. Clearing a live registry key removes only that key's own values."
        }
      ]
    },
    {
      "name": "Scratch Policy Store",
      "domain": "Policy Source",
      "responsibility": "An empty in-memory policy store that can be changed and is never saved.",
      "module": "scratch-policy-store",
      "uses": [
        "Policy File Entries"
      ],
      "enforces": [
        {
          "id": "businessrule-06218920206107794280",
          "says": "A Scratch space source is an empty policy store that can be changed but is never saved anywhere."
        }
      ]
    },
    {
      "name": "Computer File Access",
      "domain": "Policy Source",
      "responsibility": "Reads and writes policy files and their folders on the machine, creating missing policy files empty and opening them for reading and writing.",
      "module": "computer-file-access",
      "uses": [],
      "adapts": "external-90077838450756006603",
      "enforces": [
        {
          "id": "businessrule-79173574861552738237",
          "says": "When the Registry.pol of a POL file source, the local Group Policy or a per-user Group Policy does not exist, it is created empty with its folder and treated as writable; a mistyped SID therefore creates a new folder and empty file under the per-user policy folder. If creation fails, an empty read-only source is used and no error is shown."
        },
        {
          "id": "businessrule-49395771262191850050",
          "says": "A source read through the file branch covers a POL file, the local Group Policy and a per-user Group Policy, each with a Registry.pol path. An existing file is loaded; it is writable only when it can be opened for reading and writing, otherwise it can be viewed but not committed."
        }
      ]
    },
    {
      "name": "Source Location Resolver",
      "domain": "Policy Source",
      "responsibility": "Works out where a source's policy file and comment file live from its kind and the detail given.",
      "module": "source-location-resolver",
      "uses": [],
      "enforces": [
        {
          "id": "businessrule-74412475215137182202",
          "says": "The path of a policy source is fixed by its kind: Local GPO uses the Registry.pol file of the system's local Group Policy (user or machine folder) and its gpt.ini; a per-user GPO uses the folder named by the person's SID under GroupPolicyUsers; a POL file and a user hive use the path given; Scratch space has none."
        },
        {
          "id": "businessrule-62563112935081932578",
          "says": "The comment file for a source sits beside its file: the POL file or hive path with the extension changed to .cmtx; for Local GPO or per-user GPO a file named comment.cmtx in the same folder; for the registry a file under the person's local application data folder (one for user, one for machine); Scratch space has none, so comments are unavailable."
        }
      ]
    },
    {
      "name": "Source Opener",
      "domain": "Policy Source",
      "responsibility": "Closes the sources already open, opens the user and computer sources from a choice or from the default, and falls back when one cannot be opened.",
      "module": "source-opener",
      "uses": [
        "Source Location Resolver",
        "Computer File Access",
        "Live Registry Values",
        "User Hive Mounter",
        "Scratch Policy Store",
        "Policy File Codec",
        "Policy Comment Catalog",
        "Source Status Describer"
      ],
      "enforces": [
        {
          "id": "businessrule-83542226215682203251",
          "says": "Opening new policy sources first closes the ones already open. Unsaved changes are discarded for sources backed by a POL file (local Group Policy files, a chosen POL file, a per-user Group Policy object) and for the empty source. A registry source applies changes at once, and a user hive file is applied when it is closed, so those lose nothing."
        },
        {
          "id": "businessrule-27578488339642782673",
          "says": "On first start, when no policy sources were saved, both the user source and the computer source open as the local Group Policy files (Local GPO) with no extra location."
        }
      ]
    },
    {
      "name": "Source Memory",
      "domain": "Policy Source",
      "responsibility": "Remembers the chosen kinds and details of both sources and offers them again, replacing them with the defaults when they cannot be reached.",
      "module": "source-memory",
      "uses": [],
      "enforces": [
        {
          "id": "businessrule-72559528436656832979",
          "says": "When the policy sources dialog opens with the last-used sources, each side is set to the remembered kind (Local GPO, Registry, POL file, Scratch space, and for users also per-user GPO or user hive), and the registry path, file name, SID or hive path is filled in only for the kinds that carry one."
        },
        {
          "id": "businessrule-83248377690419919134",
          "says": "When the previously saved policy sources cannot be opened, the person is told \"The previous policy sources are not accessible. The defaults will be loaded.\" and both sources are saved as Local GPO, then opened quietly. Only the source type is reset; any saved location text stays."
        }
      ]
    },
    {
      "name": "Policy Comment Catalog",
      "domain": "Policy Source",
      "responsibility": "Keeps the comments of each source by policy and area, finds them when a comment is wanted and saves the whole list to the comment file location.",
      "module": "policy-comment-catalog",
      "uses": [
        "Comment File Adapter",
        "Source Location Resolver"
      ],
      "enforces": [
        {
          "id": "businessrule-40601471490811436933",
          "says": "A policy's comment in one area is empty when that source has no comment file or holds no comment for the policy, and otherwise the saved text."
        },
        {
          "id": "businessrule-76710184957379543464",
          "says": "A source's comments are used only when it has a comment file location. The folder is created if missing; an existing file is loaded and a missing file gives no comments yet. Any failure leaves that source without comments."
        },
        {
          "id": "businessrule-87767421628061265824",
          "says": "A source's comment list is saved to its comment file location whenever the list exists, even when empty; a source without comment support has no list and is skipped."
        }
      ]
    },
    {
      "name": "Comment File Adapter",
      "domain": "Policy Source",
      "responsibility": "Reads and writes the comment files beside policy sources: validates their definitions and gives each comment its own text id and prefix.",
      "module": "comment-file-adapter",
      "uses": [
        "Computer File Access"
      ],
      "adapts": "external-08492831744411585027",
      "enforces": [
        {
          "id": "businessrule-31889487085995982343",
          "says": "No comment of a comment file can be read when any comment's policy reference has no colon or a prefix that is not declared, its text is not written as \"$(resource.<id>)\", its text id is missing, or two comments resolve to the same policy."
        },
        {
          "id": "businessrule-93571958636080198306",
          "says": "A comment file is refused as unreadable when it has no comment-definitions section, a namespace entry without a prefix, a comment without a policy reference, a text without an id, or a repeated prefix, policy reference or text id. The comments of that source are then unavailable."
        },
        {
          "id": "businessrule-57614366266507799597",
          "says": "Saving comments writes every comment and text held in memory into the target file, in schema version 1.0, replacing what the file held before."
        },
        {
          "id": "businessrule-39804924157705575084",
          "says": "When comments are saved, each comment gets its own text id built from the policy's namespace, policy name and a running number, and each distinct namespace gets a prefix made from its name (dots turned into underscores) and the running number."
        }
      ]
    },
    {
      "name": "Directory Account Resolver",
      "domain": "Policy Source",
      "responsibility": "Turns a typed user name into the account's security identifier through the directory and checks that an identifier is valid.",
      "module": "directory-account-resolver",
      "uses": [],
      "adapts": "external-90078096462363044953",
      "enforces": [
        {
          "id": "businessrule-91379498462935455610",
          "says": "A name typed in the user dialog is turned into the account's security identifier (SID) on Search; if the name cannot be translated, the person is told \"The name could not be translated to a SID.\""
        },
        {
          "id": "businessrule-88238619586671903040",
          "says": "When OK is pressed with a name typed but no SID, the name is looked up first, and the dialog stays open if no SID results."
        },
        {
          "id": "businessrule-77474018484672211108",
          "says": "When OK is pressed, the SID text must be a valid SID or the person is told \"The SID is not valid. Enter a SID in the lower box, or enter a username in the top box and press Search to translate.\"; a valid SID is returned and the dialog closes."
        }
      ]
    },
    {
      "name": "Enablement Evidence Reader",
      "domain": "Policy State",
      "responsibility": "Counts enabled and disabled evidence from the values and lists a source holds for a policy and its options, and settles the policy's state in an area.",
      "module": "enablement-evidence-reader",
      "uses": [
        "Policy File Entries",
        "Live Registry Values"
      ],
      "enforces": [
        {
          "id": "businessrule-07376289294643129633",
          "says": "For a policy's list elements, a marked-for-deletion list counts as one deleted element, and a list that holds any values counts as a present element and cancels that deletion."
        },
        {
          "id": "businessrule-07554086131159240838",
          "says": "A policy's lists of on-values and off-values count as enabled or disabled evidence for each value in them that is present, using the list's own key when it names one."
        },
        {
          "id": "businessrule-22959538508130326801",
          "says": "A policy's switched-on and switched-off effects are read from its enabled and disabled values and lists; a list entry names a value and optionally its own key, falling back to the list's default key."
        },
        {
          "id": "businessrule-25766167090873157702",
          "says": "For any other element (number, text, choice, multi-line text), a value marked for deletion counts as a deleted element and a value that is present counts as a present element."
        },
        {
          "id": "businessrule-29495869201116213931",
          "says": "A policy with a registry value of its own counts as enabled evidence when that value holds its 'on' value, which is the number 1 when the template gives none, and as disabled evidence when it holds its 'off' value or is marked for deletion when the template gives none."
        },
        {
          "id": "businessrule-33872241894384295212",
          "says": "If any element is present, the elements add their count to the enabled evidence; only when none is present do deleted elements add to the disabled evidence."
        },
        {
          "id": "businessrule-46971412075927401870",
          "says": "A policy's state in one area reads \"Enabled\", \"Disabled\", \"Not Configured\" or \"Unknown\"; the computer source is read for the computer area and the user source for any other."
        },
        {
          "id": "businessrule-71909773168029429916",
          "says": "For a checkbox element: a value marked for deletion counts as one deleted element. Otherwise, each present off value (or off-list value) counts a tenth of a deleted element, and each present on value (or on-list value) counts one present element. A checkbox whose template declares no on value or on list adds no present evidence, even if it holds 1."
        },
        {
          "id": "businessrule-92873738128602220135",
          "says": "A policy is Enabled when enabled evidence exceeds disabled evidence, Disabled when disabled exceeds enabled, Not configured when there is no evidence either way, and Unclear when both are equal and above zero."
        }
      ]
    },
    {
      "name": "Semantic Text Writer",
      "domain": "Policy State",
      "responsibility": "Writes a policy's settings as semantic policy text, with or without the heading.",
      "module": "semantic-text-writer",
      "uses": [
        "Enablement Evidence Reader",
        "Option Value Reader",
        "Semantic policy writer"
      ],
      "enforces": [
        {
          "id": "businessrule-47036476815425257305",
          "says": "The fragment text starts with the heading \"Policy Plus Semantic Policy\" and a blank line only when \"Include SPOL header\" is ticked; otherwise only the fragment is shown."
        }
      ]
    },
    {
      "name": "Policy State Provider",
      "domain": "Policy State",
      "responsibility": "Gives the state of each policy in an area, and of the sources being worked on, to the screens that show them, by reading it through the evidence reader and returning it as plain facts.",
      "module": "policy-state-provider",
      "uses": [
        "Enablement Evidence Reader"
      ],
      "enforces": []
    },
    {
      "name": "Area Scope Chooser",
      "domain": "Policy Discovery",
      "responsibility": "Offers exactly three area choices and starts on the first, so both areas are shown at the start.",
      "module": "area-scope-chooser",
      "uses": [],
      "enforces": [
        {
          "id": "businessrule-85204901615179220846",
          "says": "The list of areas starts on \"User or Computer\", the first choice, so both user and computer policies are shown at start."
        },
        {
          "id": "businessrule-81666786810242280110",
          "says": "The area choice offers only \"User or Computer\", \"User\" and \"Computer\", with no free text."
        }
      ]
    },
    {
      "name": "Result Recall",
      "domain": "Policy Discovery",
      "responsibility": "Holds the last results and chosen position, reopens them without a new search, and forgets them when the search is cleared.",
      "module": "result-recall",
      "uses": [],
      "enforces": [
        {
          "id": "businessrule-38090025507732480917",
          "says": "When search results are opened from the main window and no search has been run (or it was cleared), the person is told \"No search has been run yet, so there are no results to display.\" and nothing opens."
        },
        {
          "id": "businessrule-17385510066480798684",
          "says": "When the results window is reopened, the previously selected result is selected again if it is still in the list."
        },
        {
          "id": "businessrule-78338951417255409296",
          "says": "\"Search Results\" only reopens the last results and starts no new search."
        },
        {
          "id": "businessrule-97390301066419776959",
          "says": "Clearing the search forgets the results, so reopening them reports that no search has been run."
        }
      ]
    },
    {
      "name": "Number Text Reader",
      "domain": "Policy File Exchange",
      "responsibility": "Reads typed numbers as decimal or marked hexadecimal and limits them to the 32-bit or 64-bit range.",
      "module": "number-text-reader",
      "uses": [],
      "enforces": [
        {
          "id": "businessrule-13220028854331489804",
          "says": "A number entered for a registry value is limited to 0 to 4,294,967,295 for a 32-bit value and to 0 to 18,446,744,073,709,551,615 for a 64-bit value."
        },
        {
          "id": "businessrule-85571919984782494727",
          "says": "When a typed hexadecimal number is too large to fit, the value is set to the largest allowed value; text that is not a hexadecimal number leaves the value unchanged."
        }
      ]
    }
  ]
}
